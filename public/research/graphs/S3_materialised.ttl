ficr:ApplicabilityState a owl:Class ;
    rdfs:label "ApplicabilityState"@en ;
    rdfs:comment "A controlled state indicating whether a requirement, rule, or assessment condition applies in a given context."@en ;
    rdfs:subClassOf ficr:AssessmentState .

ficr:ComplianceResult a owl:Class ;
    rdfs:label "ComplianceResult"@en ;
    rdfs:comment "A controlled assessment state representing the result of a compliance finding, such as compliant, non-compliant, or undetermined. Compliance results are attached to ComplianceFinding records so that they remain traceable to the assessed target, checked requirement, evidence status, and regulatory source."@en ;
    rdfs:subClassOf ficr:AssessmentState .

ficr:ConditionState a owl:Class ;
    rdfs:label "ConditionState"@en ;
    rdfs:comment "Physical performance status assessment of boundary condition state."@en ;
    rdfs:subClassOf ficr:AssessmentState .

ficr:Effective a owl:Class,
        owl:NamedIndividual,
        ficr:AssessmentState,
        ficr:ConditionState,
        ficr:Effective ;
    rdfs:label "Effective"@en ;
    rdfs:comment "A condition state indicating that the physical performance of a boundary element is intact and functioning as designed."@en ;
    rdfs:subClassOf ficr:ConditionState ;
    owl:disjointWith ficr:Unknown .

ficr:ImpairmentState a owl:Class ;
    rdfs:label "ImpairmentState"@en ;
    rdfs:comment "ImpairmentState of the building component."@en ;
    rdfs:subClassOf ficr:AssessmentState .

ficr:PurposeGroup1b a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup1,
        ficr:PurposeGroup1b,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup1b"@en ;
    rdfs:comment "Dwellinghouse that contains a habitable storey with a floor level a minimum of 4.5m above ground level up to a maximum of 18m."@en ;
    rdfs:subClassOf ficr:PurposeGroup1 ;
    ficr:isClassificationOf <https://lbd.example.com/building_7b7032cc-b822-417b-9aea-642906a29bd4> .

ficr:WallFoundation a owl:Class ;
    rdfs:label "WallFoundation"@en ;
    rdfs:comment "Sub-structure component, typically concrete, brick, or masonry, that transfers loads from the building's walls down to the ground or a concrete footing"@en ;
    rdfs:subClassOf ficr:StructuralElement .

