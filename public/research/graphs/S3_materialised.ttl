schema:domainIncludes a owl:AnnotationProperty .

schema:name a owl:AnnotationProperty .

schema:rangeIncludes a owl:AnnotationProperty .

bot:aggregates a owl:ObjectProperty ;
    rdfs:label "aggregerer"@da,
        "aggregates"@en ;
    rdfs:comment """This property is DEPRECATED, use bot:hasSubElement instead // ORIGINAL definition: Forbinder et aggregat (en klynge af elementer, som kan behandles som en samlet enhed) med dets delelementer. For eksempel aggregerer et ventilationsaggregat, blandt andre elementer, en ventilator og et filter.
        
Eksempel på brug af bot:aggregates i en produkt-ontologi:
```
product:Fan             rdfs:subClassOf     bot:Element .
product:Filter          rdfs:subClassOf     bot:Element .
product:hasFan          rdfs:subPropertyOf  bot:aggregates ;
                        rdfs:range          product:Fan .
product:hasFilter       rdfs:subPropertyOf  product:aggregates ;
                        rdfs:range          product:Filter .
product:AirHandlingUnit rdfs:subClassOf     bot:Element ;
                        rdfs:subClassOf     [ owl:onProperty product:hasFan ; owl:someValuesFrom  product:Fan ] ;
                        rdfs:subClassOf     [ owl:onProperty product:hasFilter ; owl:someValuesFrom  product:Filter ] .
```"""@da,
        """This property is DEPRECATED, use bot:hasSubElement instead // ORIGINAL definition: Links an aggregate (a cluster of elements that can be treated as a single unit) to its sub-elements. For example an Air Handling Unit aggregates, among other elements, a fan and a filter.
        
Example of how to use bot:aggregates in a product ontology:
```
product:Fan             rdfs:subClassOf     bot:Element .
product:Filter          rdfs:subClassOf     bot:Element .
product:hasFan          rdfs:subPropertyOf  bot:aggregates ;
                        rdfs:range          product:Fan .
product:hasFilter       rdfs:subPropertyOf  product:aggregates ;
                        rdfs:range          product:Filter .
product:AirHandlingUnit rdfs:subClassOf     bot:Element ;
                        rdfs:subClassOf     [ owl:onProperty product:hasFan ; owl:someValuesFrom  product:Fan ] ;
                        rdfs:subClassOf     [ owl:onProperty product:hasFilter ; owl:someValuesFrom  product:Filter ] .
```"""@en ;
    rdfs:seeAlso bot:hasSubElement ;
    owl:deprecated true .

bot:has3DModel a owl:ObjectProperty ;
    rdfs:label "té model 3D"@ca,
        "má 3D model"@cs,
        "har 3D-model"@da,
        "hat 3D Modell"@de,
        "has 3D model"@en,
        "tiene modelo 3D"@es,
        "مدل سه بعدی دارد"@fa,
        "omaa 3D-mallin"@fi,
        "a modèle 3D"@fr,
        "ha modello 3D"@it,
        "heeft 3D model"@nl,
        "tem modelo 3D"@pt,
        "má 3D model"@sk,
        "har 3D-modell"@sv,
        "3D modeli var"@tr,
        "含有3D模型"@zh-cn ;
    rdfs:comment "Vincula qualsevol bot:Zone o bot:Element a un IRI que identifica el seu model 3D. Aquest model 3D es pot descriure utilitzant un vocabulari RDF dedicat. En cas contrari, l'IRI de el model 3D podria ser desreferenciable, i al buscar la IRI es podria recuperar una representació de el model 3D amb algun format de dades existent pels models 3D."@ca,
        "Prepojuje akúkoľvek bot:Zone alebo bot:Element ku konkrétnemu IRI, ktoré identifikuje jej/jeho 3D model. Tento 3D model môže byť potom popísaný použitím konkrétnych RDF slovníkov. Alebo, konkrétne IRI konkrétneho 3D modelu môže byť dereferencovateľné a pokiaľ sa bude vyhľadávať podla IRI, vyhľadávajúci môže získať reprezentáciu 3D modelu pomocou/s existujúceho/cím datového/vým formátu/formátem pre reprezentáciu 3D modely."@cs,
        "Forbinder enhver instans af bot:Zone eller bot:Element med en IRI som identificerer dennes 3D-model. Denne 3D-model kan så beskrives ved brug af et dedikeret RDF-vokabular. Alternativt kan 3D-modellens IRI være dereferencerbar, sådan at der modtages en repræsentation af 3D-modellen i et eksisterende dataformat for 3D-modeller når IRIen slås op."@da,
        "Verbindet eine Instanz von bot:Zone oder bot:Element zu einer IRI, die das zugehörige 3D Modell identifiziert. Das Modell kann in einem spezifischen RDF Vokabular kodiert sein. Andernfalls kann die IRI auch dereferenzierbar sein."@de,
        "Links any bot:Zone or bot:Element to a IRI that identifies its 3D Model. This 3D Model can then be described using some dedicated RDF vocabulary. Else, the 3D Model IRI could be dereferenceable, and when looking up the IRI one could retrieve a representation of the 3D Model with some existing data format for 3D models."@en,
        "Vincula cualquier bot:Zone o bot:Element a un IRI que identifica su modelo 3D. Este modelo 3D se puede describir utilizando un vocabulario RDF dedicado. De lo contrario, el IRI del modelo 3D podría ser dereferenciable, y al buscar el IRI se podría recuperar una representación del modelo 3D con algún formato de datos existente para los modelos 3D."@es,
        "رابطه یک عنصر  bot:Zoneیا bot:Element با یک IRI که مدل سه بعدی خود را مشخص می کند. این مدل سه بعدی را می توان با برخی کلمات اختصاصی RDF توصیف کرد. به عبارت دیگر، نشانی مدل سه بعدی می تواند ارائه ای از مدل سه بعدی را با برخی از قالب های داده موجود برای مدل های سه بعدی بازیابی کند."@fa,
        "Liittää vyöhykkeen (bot:Zone) tai elementin (bot:Element) sen 3D-mallin yksilöivään IRI:in. Tämä 3D-malli voi olla kuvattu jollakin siihen tarkoitetulla RDF-sanastolla. 3D-mallin IRI voi myös osoittaa johonkin olemassa olevalla dataformaatilla kuvattuun 3D-malliin, joka on ladattavissa IRI:n kautta."@fi,
        "Relie tout bot:Zone ou bot:Element à un IRI qui identifie son modèle 3D. Ce modèle 3D peut ensuite être décrit à l'aide d'un vocabulaire RDF spécifique. Sinon, le modèle 3D de l'IRI pourrait être déréférencé, et en recherchant l'IRI, on pourrait obtenir une représentation du modèle 3D basée sur un format de données existant pour modèles 3D."@fr,
        "Collega una istanza di bot:Zone o bot:Element ad un IRI che identifica il suo modello 3D. Questo modello 3D può essere descritto usando dei vocabolari RDF dedicati. Altrimenti, lo IRI del modello 3D potrebbe essere dereferenziabile, permettendo tramite esso di raggiungere la rappresentazione del modello 3D codificata secondo un formato esistente per modelli 3D."@it,
        "Verbindt gelijk welke bot:Zone of bot:Element instantie met een IRI die een 3D model identificeert. Dit 3D model kan beschreven worden d.m.v. een gespecialiseerde RDF vocabularium. Anderzijds kan de IRI, indien opgevraagd, ook doorverwijzen naar een 3D model in een bestaand data formaat."@nl,
        "Relaciona qualquer bot:Zone ou bot:Element a um IRI que identifique o seu modelo 3D. Este modelo 3D pode ser descrito usando um vocabulário RDF dedicado. Caso contrário, o IRI do modelo 3D pode ser desreferenciável sendo possível receber, quando se pesquisa o IRI, uma representação do modelo 3D num qualquer formato de dados para modelos 3D."@pt,
        "Propojuje jakoukoliv bot:Zone nebo bot:Element ke konkrétnímu IRI, které identifikuje její/jeho 3D model. Tento 3D model potom může být popsán využitím konkrétních RDF slovníků. Nebo, konkrétní IRI konkrétního 3D modelu může být dereferencovatelné, pokud se bude vyhledávat dle IRI, vyhledávající může získat reprezentaci 3D modelu pomocí/s existujícího/jícím datového/vým formátu/formátem pro reprezentaci 3D modelu."@sk,
        "Länkar en instans av bot:Zone eller bot:Element till en IRI som identifierar dennas 3D-modell. 3D-modellen kan beskrivas med något avsett RDF-vokabulär; alternativt så kan den peka ut mot en extern representation uttryckt i något existerande dataformat för 3D-modellering."@sv,
        "bot:Zone'nin herhangi bir örneğini bağlar ya da bot:Element'i kendi 3D-modelini tanimlayan bir IRI ile bağlar. Bu 3D-model daha sonra özel bir RDF kelime kullanimi ile tanimlanabilir. Bu 3D model daha sonra özel bir RDF kelime kullanımı ile tanımlanabilir. Aksi takdirde, IRI'nin kaydı silinebilir."@tr,
        "将任何bot：Zone或bot：Element链接到标识其3D模型的IRI，然后可以使用一些专用的RDF词汇表来描述3D模型。 否则，3D模型IRI可能会被取消引用的，在此情况下，当查找IRI时，可以使用3D模型的某些现有数据格式检索3D模型。"@zh-cn ;
    rdfs:isDefinedBy bot: ;
    vs:term_status "unstable" ;
    schema:domainIncludes bot:Element,
        bot:Zone .

bot:hasBuilding a owl:ObjectProperty ;
    rdfs:label "té edifici"@ca,
        "má budovu"@cs,
        "har bygning"@da,
        "hat Gebäude"@de,
        "has building"@en,
        "tiene edificio"@es,
        "ساختمان دارد"@fa,
        "omaa rakennuksen"@fi,
        "contient bâtiment"@fr,
        "ha edificio"@it,
        "heeft gebouw"@nl,
        "tem edifício"@pt,
        "má budovu"@sk,
        "har byggnad"@sv,
        "Binası var"@tr,
        "包含建筑"@zh-cn ;
    rdfs:comment "Relació amb els edificis continguts en una zona. Els dominis típics de bot:hasBuilding són instàncies de bot:Site"@ca,
        "Vztah budov které jsou přilehlé k zóně. Typickým příkladem je bot:hasBuilding která je instancí bot:Site tzn. staveniště (stav. pozemeek) má budovu, budova stojí na pozemku."@cs,
        "Relation til bygninger indeholdt i en zone. De typiske domæner for bot:hasBuilding er forekomster af bot:Site."@da,
        "Beziehung zwischen Gebäuden, die in einer Zone enthalten sind. Oft ist hier die rdfs:domain eine Instanz von bot:Site."@de,
        "Relation to buildings contained in a zone. The typical domains of bot:hasBuilding are instances of bot:Site."@en,
        "Relación con los edificios contenidos en una zona. Los dominios típicos de bot:hasBuilding son instancias de bot:Site."@es,
        "ارتباط  با ساختمانهابی که دربرگرفته شده‌اند. دامنه اصلی bot:hasBuilding عنصرهایی از جنس bot:Site هستند."@fa,
        "Suhde vyöhykkeeseen kuuluviin rakennuksiin. Tyypillinen lähtöjoukko on luokan bot:Site instanssit."@fi,
        "Relation à définir entre les bâtiments d'une même zone. Cette propriété s'applique typiquement sur des instances de bot:Site."@fr,
        "Relazione con gli edifici contenuti in una zona. Il tipico dominio di bot:hasBuilding è bot:Site."@it,
        "Relatie tot gebouwen die zich in een zone bevinden. De typische domeinen van bot:hasBuilding zijn instanties van bot:Site"@nl,
        "Relação com edifícios contidos numa zona. Os domínios típicos de bot:hasBuilding são instâncias de bot:Site."@pt,
        "Vzťah budovy a pozemku, na ktorom stojí. Typická doména bot:hasBuilding je inštanciou bot:Site. Tzn. stavenisko(stavebný pozemok) má budovu."@sk,
        "Relation till byggnader som inryms i en zon. Typiska domäner för bot:hasBuilding är förekomster av bot:Site."@sv,
        "Bir bölgeye dahil binalara ile ilişkisi. Bot:hasBuilding için tipik etki alanları bot:Site örnekleridir."@tr,
        "区域中含有建筑的关系。 bot：hasBuilding的典型使用范围是bot：Site中的实例。"@zh-cn ;
    rdfs:domain bot:Zone ;
    rdfs:isDefinedBy bot: ;
    rdfs:range bot:Building ;
    rdfs:subPropertyOf bot:containsZone ;
    vs:term_status "stable" ;
    schema:domainIncludes bot:Site .

bot:hasSimple3DModel a owl:DatatypeProperty ;
    rdfs:label "té un model 3D senzill"@ca,
        "má jednoduchý 3D model"@cs,
        "har simpel 3D-model"@da,
        "hat einfaches 3D Modell"@de,
        "has simple 3D model"@en,
        "tiene modelo 3D simple"@es,
        "مدل سه بعدی ساده دارد"@fa,
        "omaa yksinkertaisen 3D-mallin"@fi,
        "a modèle 3D simple"@fr,
        "ha modello 3D semplice"@it,
        "heeft eenvoudig 3D model"@nl,
        "tem modelo 3D simples"@pt,
        "má jednoduchý 3D model"@sk,
        "har enkel 3D-modell"@sv,
        "Basit bir 3D modeli var"@tr,
        "含有简单的3D模型"@zh-cn ;
    rdfs:comment "Vincula qualsevol bot:Zone o bot:Element a un model 3D codificat com literal."@ca,
        "Propojuje jakýkoliv bot:Zone nebo bot:Element na 3D model definovaný jako literál."@cs,
        "Forbinder enhver instans af bot:Zone eller bot:Element med en 3D-model beskrevet som en literal."@da,
        "Verbindet jede bot:Zone oder bot:Element zu einem 3D Model, dass als Literal codiert ist."@de,
        "Links any bot:Zone or bot:Element to a 3D Model encoded as a literal."@en,
        "Vincula cualquier bot:Zone o bot:Element a un modelo 3D codificado como literal."@es,
        "رابطه یک عنصر  bot:Zone یا  bot:Elementبا یک مدل سه بعدی که به صورت یک نوشته رمزگذاری شده است."@fa,
        "Liittää vyöhykkeen (bot:Zone) tai elementin (bot:Element) sen yksinkertaiseksi arvoksi enkoodattuun 3D-malliin."@fi,
        "Relie tout bot:Zone ou bot:Element à un modèle 3D encodé comme"@fr,
        "Collega una istanza di bot:Zone o bot:Element ad un modello 3D codificato come un literal."@it,
        "Verbindt gelijk welke bot:Zone of bot:Element instantie met een 3D model geëncodeerd in een literal."@nl,
        "Vincula qualquer bot:Zone ou bot:Element a um Modelo 3D codificado como um literal."@pt,
        "Prepojuje akýkoľvek bot:Zone alebo bot:Element na 3D model definovaný ako literál."@sk,
        "Länkar en instans av bot:Zone eller bot:Element till en 3D-modell uttryckt som en RDF literal."@sv,
        "bot:Zone'nin herhangi bir örneğini bağlar ya da bot:Element'i bir literal olarak tanimlanan 3D-model ile bağlar."@tr,
        "将任何bot：Zone或bot：Element链接到编码为文本的3D模型。"@zh-cn ;
    rdfs:isDefinedBy bot: ;
    vs:term_status "unstable" ;
    schema:domainIncludes bot:Element,
        bot:Zone .

bot:hasSpace a owl:ObjectProperty ;
    rdfs:label "té espai"@ca,
        "má prostor"@cs,
        "har rum"@da,
        "hat Raum"@de,
        "has space"@en,
        "tiene espacio"@es,
        "فضا دارد"@fa,
        "omaa tilan"@fi,
        "contient pièce"@fr,
        "ha spazio"@it,
        "heeft ruimte"@nl,
        "tem espaço"@pt,
        "má priestor"@sk,
        "har rum"@sv,
        "Odası var"@tr,
        "包含空间"@zh-cn ;
    rdfs:comment "Relació a espais continguts en una zona. Els dominis típics de bot:hasSpace són instàncies de bot:Storey o bot:Building."@ca,
        "Vztah prostorů nacházejících se v zóně a dané zóny. Typická doména bot:hasSpace jsou instance bot:Storey a bot:Building."@cs,
        "Relation til rum indeholdt i en zone. De typiske domæner for bot:hasSpace er forekomster af bot:Storey og bot:Building."@da,
        "Beziehung von Räumen, die sich in einer Zone befinden. Oft ist die rdfs:domain eine Instanz von bot:Storey oder bot:Building."@de,
        "Relation to spaces contained in a zone. The typical domains of bot:hasSpace are instances of bot:Storey or bot:Building."@en,
        "Relación a espacios contenidos en una zona. Los dominios típicos de bot:hasSpace son instancias de bot:Storey o bot:Building."@es,
        "ارتباط با فضاهایی که دربرگرفته شده‌اند. دامنه‌ی اصلی  bot:hasSpace عنصرهایی از جنس bot:Building  وbot:Storey هستند."@fa,
        "Suhde vyöhykkeeseen kuuluviin tiloihin. Tyypillinen lähtöjoukko ovat luokkien bot:Storey tai bot:Building instanssit."@fi,
        "Relation à définir entre les pièces d'une même zone. Cette propriété s'applique typiquement sur des instances de bot:Storey et bot:Building."@fr,
        "Relazione con gli spazi contenuti in una zona. Il tipico dominio di bot:hasSpace è l'unione di bot:Storey e bot:Building."@it,
        "Relatie tot ruimtes die zich in een zone bevinden. De typische domeinen van bot:hasSpace zijn instanties van bot:Storey of bot:Building."@nl,
        "Relação com espaços contidos numa zona. Os domínios típicos de bot:hasSpace são instâncias de bot:Storey ou de bot:Building."@pt,
        "Vzťah priestorov nachádzajúcich sa v zóne a danej zóny. Typická doména bot:hasSpace sú inštancie bot:Storey a bot:Buuilding."@sk,
        "Relation till rum som inryms i en zon. Typiska domäner för bot:hasSpace är förekomster av bot:Storey och bot:Building."@sv,
        "Bir bölgede bulunan odalarla ilişkisi. Bot:hasSpace için tipik etki alanları bot:Building ve bot:Storey örnekleridir."@tr,
        "区域含有空间的关系。 bot：hasSpace的典型使用范围是bot：Storey和bot：Building中的实例。"@zh-cn ;
    rdfs:domain bot:Zone ;
    rdfs:isDefinedBy bot: ;
    rdfs:range bot:Space ;
    rdfs:subPropertyOf bot:containsZone ;
    vs:term_status "stable" ;
    schema:domainIncludes bot:Storey .

bot:hasStorey a owl:ObjectProperty ;
    rdfs:label "té pis"@ca,
        "má podlaží"@cs,
        "har etage"@da,
        "hat Geschoss"@de,
        "has storey"@en,
        "tiene piso"@es,
        "طبقه دارد"@fa,
        "omaa kerroksen"@fi,
        "a étage"@fr,
        "ha piano"@it,
        "heeft verdieping"@nl,
        "tem piso"@pt,
        "má podlažie"@sk,
        "har våning"@sv,
        "Katı var"@tr,
        "包含楼层"@zh-cn ;
    rdfs:comment "Relació amb els pisos continguts en una zona. Els dominis típics de bot: hasStorey son instàncies de bot:Building."@ca,
        "Vztah zóny-podlaží a zóny, ve které se nachází. Typická doména bot:hasStorey jsou instance bot:Building."@cs,
        "Relation til etager indeholdt i en zone. De typiske domæner for bot:hasStorey er forekomster af bot:Building."@da,
        "Beziehung zwischen Geschossen, die in einer Zone enthalten sind. Oft ist die rdfs:domain eine Instanz von bot:Building."@de,
        "Relation to storeys contained in a zone. The typical domains of bot:hasStorey are instances of bot:Building."@en,
        "Relación con los pisos contenidos en una zona. Los dominios típicos de bot:hasStorey son instancias de bot:Building."@es,
        "ارتباط با طبقه‌هایی که دربرگرفته شده‌اند. دامنه‌ی اصلی bot:hasStorey عنصرهایی از جنس bot:Building هستند."@fa,
        "Suhde vyöhykkeeseen kuuluviin kerroksiin. Tyypillinen lähtöjoukko on luokan bot:Building instanssit."@fi,
        "Relation à définir entre les étages d'une même zone. Cette propriété s'applique typiquement sur des instances de bot:Building."@fr,
        "Relazione con i piani contenuti in una zona. Il tipico dominio di bot:hasStorey è bot:Building."@it,
        "Relatie tot de verdiepingen die zich in een zone bevinden. De typische domeinen van bot:hasStorey zijn instanties van bot:Building."@nl,
        "Relação com os pisos contidos numa zona. Os domínios típicos de bot:hasStorey são instâncias de bot:Building."@pt,
        "Vzťah zóny-podlažia a zóny, v ktorej sa nachádza. Typická doména bot:hasStorey sú inštancie bot:Building."@sk,
        "Relation som uttrycker vilka våningar som finns i en Zon. Används typiskt med instanser av bot:Building."@sv,
        "Bir bölgede bulunan katlarla ilişkisi. Bot:hasStorey için tipik etki alanları bot:Building örnekleridir."@tr,
        "区域中含有楼层的关系。 bot：hasStorey的典型使用范围是bot：Building中的实例。"@zh-cn ;
    rdfs:domain bot:Zone ;
    rdfs:isDefinedBy bot: ;
    rdfs:range bot:Storey ;
    rdfs:subPropertyOf bot:containsZone ;
    vs:term_status "stable" ;
    schema:domainIncludes bot:Building .

bot:hasZeroPoint a owl:ObjectProperty ;
    rdfs:label "té un punt zero"@ca,
        "má nulový bod"@cs,
        "har nulpunkt"@da,
        "hat Nullpunkt"@de,
        "has zero point"@en,
        "tiene punto cero"@es,
        "نقطه صفر دارد"@fa,
        "omaa nollapisteen"@fi,
        "a point origine"@fr,
        "ha punto zero"@it,
        "heeft nulpunt"@nl,
        "tem ponto zero"@pt,
        "má nulový bod"@sk,
        "har origo"@sv,
        "Sıfır noktasi var"@tr,
        "含有原点"@zh-cn ;
    rdfs:comment "Vincula un bot:Site a una instància que codifica la latitud i longitud de el punt zero del lloc de l'edifici. Aquesta pot ser una instància d'un wgs84:Point. La definició de SIG i de la geometria no està dins de l'abast de la BOT, per tant, l'usuari haurà de seleccionar una ontologia apropiada. L'ús d'aquesta propietat és potencialment ambigua i podria ser eliminada o revisada en edicions futures de l'ontologia."@ca,
        "Napojuje bot:Site na instanci, který definuje zeměpisnou šířku a délku nulového bodu budovy. To může být instancí wgs84:Point. Definice GIS a geometrie není v rozsahu BOT a je potřebné použít jinou adekvátní ontologii. Využití této vlastnosti je potenciálně nepřesné a nejasné a může být odstraněno nebo revidováno v budoucích úpravách této ontologie."@cs,
        "Forbinder et bot:Site med en forekomst, der beskriver en længde- og breddegrad for byggegrundens nulpunkt. Dette kunne være en forekomst af et wgs84:Point. Definitionen af GIS og geometri er ikke omfattet af BOT og en passende ontologi må her vælges af brugeren. Brugen af denne egenskab er potentielt tvetydig, og den kan fjernes eller revideres i fremtidige udgaver af ontologien."@da,
        "Verbindet eine Instanz von bot:Site mit einer Instanz, die den Längen- und Breitengrad des Nullpunkts des Grundstücks definiert. Dies kann eine Instanz eines wgs84:Point sein. Die Definition von GIS und Geometrie ist nicht Bestandteil von BOT. Die Nutzung dieses Properties ist potenziell zweideutig und es besteht die Möglichkeit das es in Zukunft überarbeitet oder entfernt wird."@de,
        "Links a bot:Site to an instance that encodes the latitude and longitude of the Zero Point of the building site. This could be an instance of a wgs84:Point. The definition of GIS and geometry is not within the scope of BOT and an appropriate ontology needs to be selected here by the user. The use of this property is potentially ambiguous and it might be removed or revised in future editions of the ontology."@en,
        "Vincula un bot:Site a una instancia que codifica la latitud y longitud del punto cero del sitio del edificio. Esta puede ser una instancia de un wgs84:Point. La definición de SIG y de la geometría no está dentro del alcance de BOT por lo que el usuario deberá utilizar para ello una ontología apropiada en combinación con BOT. El uso de esta propiedad es potencialmente ambigua y podría ser eliminada o revisada en ediciones futuras de la ontología."@es,
        "رابطه یک عنصر bot:Site با عنصری که طول وعرض جغرافیایی نقطه صفر سایت ساختمان را مشخص می کند. این میتواند یک عنصراز wgs84:Point باشد. تعریف GIS و هندسه در دایره‌ وضایف آنتالوژی جاینگاری ساختمان (BOT) نیست و لازم است یک آنتالوژی مناسب توسط کاربر برای این موضوع انتخاب شود. استفاده از این ویژگی به طور بالقوه ای مبهم است و ممکن است در نسخه های بعدی این آنتالوژی حذف یا اصلاح شود."@fa,
        "Liittää bot:Site:n instanssiin, jolla merkitään rakennustyömaan nollakohdan leveys- ja pituuspiirit. Tämä voi olla esimerkki wgs84:Point-luokan instanssi. BOT ei kata GIS:ä tai geometriaa, joten käyttäjän tulee valita sopiva ontologia.Tämän propertyn käyttö on mahdollisesti moniselitteistä, ja se voidaan poistaa tai tarkistaa ontologian tulevissa versioissa."@fi,
        "Lie un bot:Site à un individu qui encode la latitude et la longitude du point zéro du site du bâtiment. Ceci peut être une instance de wgs84:Point. La définition du système de coordonnée géographique et de la géométrie n'est pas défini par BOT et l'utilisateur doit choisir l'ontologie appropriée. L'utilisation de cette propriété est potentiellement ambigue et elle pourrait être supprimée ou modifiée dans les prochaines versions de l'ontologie."@fr,
        "Collega un bot:Site ad un'istanza che codifica la latitudine e longitudine del punto zero di un sito. Questa può essere l'istanza di wgs84:Point. La definizioen di GIS e geometrie non rientra nell'ambito di BOT ed è pertanto necessario che l'utente selezioni una ontologia adeguata. L'uso di questa proprietà è potenzialmente ambiguo e potrebbe essere rimossa o revisionata in successive edizioni dell'ontologia."@it,
        "Verbindt een bot:Zone instantie met een instantie die de lengtegraad en breedtegraad definieert van het nulpunt van een bot:Site instantie. Dit kan een instantie zijn van wgs84:Point. De definitie van GIS en geometrie valt niet in de scope van BOT en de gebruiker moet een gepaste ontology hiervoor selecteren. Het gebruik van deze eigenschap is potentieel ambigu en kan verwijderd of herzien worden in toekomstige versies van deze ontologie."@nl,
        "Relaciona um bot:Site com uma instância que codifica a latitude e longitude do ponto zero de um sítio de construção. Este poderá ser uma instância de um wgs84:Point. As definições de SIG e de geometria não estão no escopo de BOT, sendo necessário que o/a utilizador/a seleccione uma ontologia adequada para o efeito. A utilização desta propriedade é potencialmente ambígua, podendo esta ser removida ou revista em versões futuras desta ontologia."@pt,
        "Napojuje bot:Site na inštanciu ktorá definuje zemepisnú šírku a dĺžku nulového bodu budovy. To môže byť inštanciou wgs84:Pint. Definícia GIS a geometrie nie je v rozsahu BOT a je potrebné použiť inú adekvátnu ontológiu. Využitie tejto vlastnosti je potenciálne nepresné a nejasné a môže byť odstránené alebo revidované v budúcich úpravách tejto ontológie."@sk,
        "Länkar en byggnadsplats (en instans av bot:Site) till en instans som uttrycker latitud och longitud för den berörda byggnadsplatsens origo. Detta kan exempelvis vara en instans av wgs84:Point. Definitioner för GIS och geometrier är utanför BOTs scope och användaren ansvarar själv för att välja en lämplig ontologi för detta syfte. Användningen av denna relation är potentiellt tvetydig och den kan komma att revideras eller tas bort i framtida versioner av ontologin."@sv,
        "bir bot:Site ile bir olusumla bağlantı kurar: Bina alanının sıfır noktasında enlem ve boylamını tanımlayan bir örnekle bağlar. Bu bir wgs84:Point örneği olabilir. GPS ve geometrinin tanımı BOT kapsamında değildir ve kullanıcı tarafından uygun bir ontoloji seçilmelidir. Bu özelliğin kullanımı potansiyel olarak belirsizdir ve gelecekteki ontolojinin sürümlerinde kaldırılabilir veya revize edilebilir."@tr,
        "将bot：Site链接到一个实例，对该实例建筑位置原点的纬度和经度进行编码。 这可以是wgs84：Point的一个实例。 GIS和几何的定义不在BOT的范围内，用户需要在此处选择适当的本体。该属性的使用可能是模棱两可的，并且在以后的本体版本中可能会删除或修改它。"@zh-cn ;
    rdfs:domain bot:Site ;
    rdfs:isDefinedBy bot: ;
    rdfs:seeAlso <https://github.com/w3c-lbd-cg/bot/issues/41> ;
    vs:term_status "unstable" .

bot:hostsElement a owl:ObjectProperty ;
    rdfs:label "hoster element"@da,
        "hosts element"@en,
        "heeft element"@nl,
        "hoster element"@nl ;
    rdfs:comment "This property is DEPRECATED, use bot:hasSubElement instead // ORIGINAL definition: Relation mellem en bygningsdel a) og en anden bygningsdel b) hostet af element a). Eksempel: inst:wall bot:hostsElement inst:window"@da,
        "This property is DEPRECATED, use bot:hasSubElement instead // ORIGINAL definition: Relation between an element a) and another element b) hosted by element a). Example: inst:wall bot:hostsElement inst:window"@en,
        "This property is DEPRECATED, use bot:hasSubElement instead // ORIGINAL definition: Relatie tussen een gebouwelement a) en een ander element b) dat een ander element in zich heeft a). Voorbeeld: inst:wall bot:hostsElement inst:window"@nl ;
    rdfs:domain bot:Element ;
    rdfs:range bot:Element ;
    rdfs:seeAlso bot:hasSubElement ;
    owl:deprecated true .

bot:interfaceOf a owl:ObjectProperty ;
    rdfs:label "interfície de"@ca,
        "je rozhraní/je rozhraním"@cs,
        "grænseflade for"@da,
        "Schnittstelle von"@de,
        "interface of"@en,
        "interfaz de"@es,
        "رابط است"@fa,
        "rajapintana"@fi,
        "interface de"@fr,
        "interfaccia di"@it,
        "interface van"@nl,
        "interface de"@pt,
        "je rozhranie/rozhraním"@sk,
        "gränssnitt för"@sv,
        "Arayüzü"@tr,
        "交界面于"@zh-cn ;
    rdfs:comment "Relació entre una interfície i una altra cosa (zona de construcció, element o owl:Thing)"@ca,
        "Vztah mezi rozhraním a přilehlou zónou nebo prvkem."@cs,
        "Relation mellem en grænseflade og en anden ting (bygningszone, bygningsdel eller owl:Thing)."@da,
        "Beziehung zwischen einer Schnittstelle und einem anderen Ding (Gebäude zone, Bauteil oder owl:Thing)."@de,
        "Relationship between an interface and another thing (building zone, element or owl:Thing)"@en,
        "Relación entre una interfaz y otra cosa (zona de construcción, elemento o owl:Thing)"@es,
        "رابطه بین یک رابط و یک عنصر دیگر (منطقه ساختمان، المان، و یا owl:Thing)"@fa,
        "Suhde rajapinnan ja toisen asian välillä (rakennuksen vyöhyke, elementti, tai owl:Thing)."@fi,
        "Relation à définir entre une interface et une zone ou un élément adjacents."@fr,
        "Relazione tra un'interfaccia e un'altra cosa (zona di edificio, elemento di costruzione o owl:Thing)"@it,
        "Relatie tussen een interface en een ander ding (gebouwzone, gebouwelement of owl:Thing)."@nl,
        "Relação entre um interface e outra coisa (zona do edifício, elemento ou owl:Thing)"@pt,
        "Vzťah medzi rozhraním a priľahlou zónou alebo prvkom."@sk,
        "Relation mellan ett gränssnitt och något angränsande (en zon, en byggdel, eller owl:Thing)."@sv,
        "Bir arabirim ile bitişik bir bölge veya bina parçası arasındaki ilişki."@tr,
        "界面与其他对象（建筑热区，构件或owl:Thing）之间的关系。"@zh-cn ;
    rdfs:domain bot:Interface ;
    rdfs:isDefinedBy bot: ;
    vs:term_status "stable" .

ficr:ADB a owl:NamedIndividual,
        ficr:AssessmentBasis,
        ficr:GuidanceDocument,
        ficr:RegulatorySource ;
    rdfs:label "ADB"@en ;
    rdfs:comment """Approved Document B Volume 1&2\r
Building regulation in England covering fire safety matters within and around buildings."""@en .

ficr:AnomalyTriggerEvent a owl:Class ;
    rdfs:label "AnomalyTriggerEvent"@en ;
    rdfs:comment "A trigger event generated when abnormal conditions are detected by monitoring or analytics, causing tasks to be created for verification, inspection, or risk follow-up."@en ;
    rdfs:subClassOf ficr:Event .

ficr:ApplianceVentilationDuct a owl:Class ;
    rdfs:label "ApplianceVentilationDuct"@en ;
    rdfs:comment "A duct to deliver combustion air to a gas appliance."@en ;
    rdfs:subClassOf ficr:HVACSystem .

ficr:AtriumSpace a owl:Class ;
    rdfs:label "AtriumSpace"@en ;
    rdfs:comment """A continuous space that passes through one or more structural floors within a building, not necessarily vertically.\r
Enclosed lift wells, enclosed escalator wells, building services ducts and stairs are not classified as atria."""@en ;
    rdfs:subClassOf bot:Space ;
    owl:disjointWith ficr:BalconySpace,
        ficr:CavitySpace,
        ficr:DuctSpace,
        ficr:RoofSpace,
        ficr:RoomSpace,
        ficr:ShaftSpace,
        ficr:StairSpace .

ficr:AutomaticReleaseMechanism a owl:Class ;
    rdfs:label "AutomaticReleaseMechanism"@en ;
    rdfs:comment """A device that normally holds a door open, but closes it automatically if any one of the following occurs.\r
• Smoke is detected by an automatic device of a suitable nature and quality in a suitable location.\r
• A hand-operated switch, fitted in a suitable position, is operated.\r
• The electricity supply to the device, apparatus or switch fails.\r
• The fire alarm system, if any, is operated."""@en ;
    rdfs:subClassOf ficr:FireProtectionEquipment .

ficr:BDM02 a owl:NamedIndividual,
        ficr:AssessmentBasis,
        ficr:GuidanceDocument,
        ficr:RegulatorySource ;
    rdfs:label "BDM02"@en ;
    rdfs:comment """Fire Protection of Buildings\r
RISCAuthority BDM02 - Fire Protection of Buildings - 2022 v2 A4"""@en .

ficr:BS_EN_12845 a owl:NamedIndividual,
        ficr:AssessmentBasis,
        ficr:RegulatorySource,
        ficr:Standard ;
    rdfs:label "BS_EN_12845"@en ;
    rdfs:comment "Fixed firefighting systems. Automatic sprinkler systems. Design, installation and maintenance."@en .

ficr:CavityBarrier a owl:Class ;
    rdfs:label "CavityBarrier"@en ;
    rdfs:comment """A construction within a cavity, other than a smoke curtain, to perform either of the\r
following functions.\r
• Close a cavity to stop smoke or flame entering.\r
• Restrict the movement of smoke or flame within a cavity."""@en ;
    rdfs:subClassOf ficr:FabricElement,
        ficr:FireProtectionElement .

ficr:Cladding a owl:Class ;
    rdfs:label "Cladding"@en ;
    rdfs:comment "Cladding is an external layer applied to a building's structure to provide weather protection, thermal insulation, and improved aesthetics."@en ;
    rdfs:subClassOf ficr:ExternalWall .

ficr:Column a owl:Class ;
    rdfs:label "Column"@en ;
    rdfs:comment "A column is a vertical structural element in a building that supports loads from above and transfers them down to the foundation."@en ;
    rdfs:subClassOf ficr:StructuralElement .

ficr:ComplianceRequestTriggerEvent a owl:Class ;
    rdfs:label "ComplianceRequestTriggerEvent"@en ;
    rdfs:comment "A trigger event created when a compliance request is received from an external authority, or when a prior task identifies missing evidence or unmet preconditions requiring follow-up inspection or assessment."@en ;
    rdfs:subClassOf ficr:Event .

ficr:Controller a owl:Class ;
    rdfs:label "Controller"@en ;
    rdfs:comment "In buildings, a \"controller\" is the \"brain\" of an automated system, receiving data from sensors and sending commands to devices like HVAC, lighting, and alarms to ensure comfort and efficiency."@en ;
    rdfs:subClassOf ficr:Equipment .

ficr:Curtain a owl:Class ;
    rdfs:label "Curtain"@en ;
    rdfs:comment "Part of a solar shading device which is set in motion by the operating system and fulfils the purpose of a blind, awning or shutter."@en ;
    rdfs:subClassOf ficr:FabricElement .

ficr:EscapeLighting a owl:Class ;
    rdfs:label "EscapeLighting"@en ;
    rdfs:comment "The part of the emergency lighting that is provided to ensure that the escape route is illuminated at all material times."@en ;
    rdfs:subClassOf ficr:EmergencyLightingSystem .

ficr:EvacuationLift a owl:Class ;
    rdfs:label "EvacuationLift"@en ;
    rdfs:comment "A lift that may be used to evacuate people in a fire."@en ;
    rdfs:subClassOf ficr:FireProtectionSystem,
        ficr:LiftSystem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:LiftSystem [ a owl:Restriction ;
                        owl:onProperty ficr:hasSystemFireSafetyRole ;
                        owl:someValuesFrom ficr:EvacuationRole ] ) ] .

ficr:Finishes a owl:Class ;
    rdfs:label "Finishes"@en ;
    rdfs:comment "Finishes are the final surface treatments and decorative elements applied to a building's interior and exterior."@en ;
    rdfs:subClassOf ficr:BuildingContent .

ficr:FireAlarmSystem a owl:Class ;
    rdfs:label "FireAlarmSystem"@en ;
    rdfs:comment "A system-level arrangement of components for detecting fire and giving audible, visual, or other perceptible warning of fire."@en ;
    rdfs:subClassOf ficr:FireProtectionSystem .

ficr:FireAndSmokeDamper a owl:Class ;
    rdfs:label "FireAndSmokeDamper"@en ;
    rdfs:comment "A fire damper which, in addition to the performance of the fire damper, resists the spread of smoke."@en ;
    rdfs:subClassOf ficr:FireDamper .

ficr:FireCompartment a owl:Class ;
    rdfs:label "FireCompartment"@en ;
    rdfs:comment "A fire safety space bounded by compartment walls and compartment floors, designed to prevent the spread of fire and smoke beyond the compartment of origin."@en ;
    rdfs:subClassOf ficr:FireProtectionSpatialProvision ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bot:Zone [ a owl:Restriction ;
                        owl:onProperty bot:adjacentElement ;
                        owl:someValuesFrom ficr:CompartmentFloor ] [ a owl:Restriction ;
                        owl:onProperty bot:adjacentElement ;
                        owl:someValuesFrom ficr:CompartmentWall ] ) ] .

ficr:FireDoorset a owl:Class ;
    rdfs:label "FireDoorset"@en ;
    rdfs:comment "A door or shutter which, together with its frame and furniture as installed in a building, is intended (when closed) to resist the spread of fire and/or gaseous products of combustion and meets specified performance criteria to those ends."@en ;
    rdfs:subClassOf ficr:Doorset,
        ficr:FireProtectionElement ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:Doorset [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty ficr:hasPhysicalObjectFireSafetyRole ;
                                    owl:someValuesFrom ficr:FireResistingRole ] [ a owl:Restriction ;
                                    owl:onProperty ficr:hasPhysicalObjectFireSafetyRole ;
                                    owl:someValuesFrom ficr:FireSeparatingRole ] ) ] ) ] .

ficr:FireFightingLift a owl:Class ;
    rdfs:label "FireFightingLift"@en ;
    rdfs:comment "A lift with additional protection and with controls that enable it to be used by the fire and rescue service when fighting a fire."@en ;
    rdfs:subClassOf ficr:FireProtectionSystem,
        ficr:LiftSystem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:LiftSystem [ a owl:Restriction ;
                        owl:onProperty ficr:hasSystemFireSafetyRole ;
                        owl:someValuesFrom ficr:FirefightingRole ] ) ] .

ficr:FireSprinklerSystem a owl:Class ;
    rdfs:label "FireSprinklerSystem"@en ;
    rdfs:comment "A fire protection system that uses a network of pipes, control components, and sprinkler outlets to discharge water for fire suppression or control."@en ;
    rdfs:subClassOf ficr:FireProtectionSystem,
        ficr:PipingSystem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:PipingSystem [ a owl:Restriction ;
                        owl:onProperty ficr:hasSystemFireSafetyRole ;
                        owl:someValuesFrom ficr:ActiveFireProtectionRole ] ) ] .

ficr:FireStop a owl:Class ;
    rdfs:label "FireStop"@en ;
    rdfs:comment "A seal provided to close an imperfection of fit or design tolerance between elements or components, to restrict the spread of fire and smoke."@en ;
    rdfs:subClassOf ficr:FabricElement,
        ficr:FireProtectionElement .

ficr:LiftShaft a owl:Class ;
    rdfs:label "LiftShaft"@en ;
    rdfs:comment "A lift shaft is a vertical passageway in a building where an elevator travels between floors."@en ;
    rdfs:subClassOf ficr:ShaftSpace .

ficr:MaintenanceRecordEvidence a owl:Class ;
    rdfs:label "MaintenanceRecordEvidence"@en ;
    rdfs:comment "A document evidence item representing a maintenance record that supports an assessment finding or record."@en ;
    rdfs:subClassOf ficr:DocumentEvidence .

ficr:PhotographEvidence a owl:Class ;
    rdfs:label "PhotographEvidence"@en ;
    rdfs:comment "A document evidence item representing a photograph that supports an assessment finding or record."@en ;
    rdfs:subClassOf ficr:DocumentEvidence .

ficr:ProtectedCircuit a owl:Class ;
    rdfs:label "ProtectedCircuit"@en ;
    rdfs:comment "An electrical circuit that is protected against fire."@en ;
    rdfs:subClassOf ficr:Circuit,
        ficr:FireProtectionSystem ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:Circuit [ a owl:Restriction ;
                        owl:onProperty ficr:hasSystemFireSafetyRole ;
                        owl:someValuesFrom ficr:PassiveFireProtectionRole ] ) ] .

ficr:ProtectedCorridor a owl:Class ;
    rdfs:label "ProtectedCorridor"@en ;
    rdfs:comment "A corridor that is adequately protected from fire in adjoining areas by fire resisting construction."@en ;
    rdfs:subClassOf ficr:FireProtectionSpatialProvision ;
    owl:disjointWith ficr:ProtectedEntranceHall,
        ficr:ProtectedLobby,
        ficr:ProtectedShaft,
        ficr:ProtectedStairwaySpace ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bot:Zone [ a owl:Restriction ;
                        owl:onProperty ficr:hasZoneFireSafetyRole ;
                        owl:someValuesFrom ficr:PassiveFireProtectionRole ] [ a owl:Restriction ;
                        owl:hasValue ficr:Corridor ;
                        owl:onProperty ficr:hasSpaceUsage ] ) ] .

ficr:ProtectedStairway a owl:Class ;
    rdfs:label "ProtectedStairway"@en ;
    rdfs:comment "A stair that leads to a final exit to a place of safety and that is adequately enclosed with fire resisting construction. Included in the definition is any exit passageway between the foot of the stair and the final exit."@en ;
    rdfs:subClassOf ficr:FireProtectionElement,
        ficr:Stair ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:Stair [ a owl:Restriction ;
                        owl:onProperty ficr:hasPhysicalObjectFireSafetyRole ;
                        owl:someValuesFrom ficr:PassiveFireProtectionRole ] ) ] .

ficr:RegulatoryInstrument a owl:Class ;
    rdfs:label "RegulatoryInstrument"@en ;
    rdfs:comment "Laws, regulations, and regulatory documents with statutory binding force."@en ;
    rdfs:subClassOf ficr:RegulatorySource .

ficr:RelevantBoundary a owl:Class ;
    rdfs:label "RelevantBoundary"@en ;
    rdfs:comment "The boundary or notional boundary that one side of the building faces and/or coincides with, and that is parallel or at an angle of a maximum of 80 degrees to that side of the building."@en ;
    rdfs:subClassOf ficr:SiteBoundary .

ficr:Risk_Evaluation_Tool a owl:NamedIndividual,
        ficr:AssessmentBasis,
        ficr:GuidanceDocument,
        ficr:RegulatorySource ;
    rdfs:label "Risk_Evaluation_Tool"@en ;
    rdfs:comment "The Building Risk Evaluation Tool (BRET), is intended to provide an easy to follow insight into how the use, design, and construction material choices can influence the resilience of a building to the challenges presented by fire in terms of property protection, business resilience, and insurability. It may provide benefit to designers during the initial development stages looking to ensure the end result will meet the resilience expectations of the occupier and be insurable, and to insurers triaging new prospects."@en .

ficr:Rooflight a owl:Class ;
    rdfs:label "Rooflight"@en ;
    rdfs:comment "A dome light, lantern light, ridge light."@en ;
    rdfs:subClassOf ficr:Closing .

ficr:RooflightOpening a owl:Class ;
    rdfs:label "RooflightOpening"@en ;
    rdfs:comment "A skylight, glazed barrel vault or other element to admit daylight through a roof."@en ;
    rdfs:subClassOf ficr:Opening .

ficr:SelfClosingDevice a owl:Class ;
    rdfs:label "SelfClosingDevice"@en ;
    rdfs:comment """A device that closes a door, when open at any angle, against a door frame.\r
NOTE: If the door is in a cavity barrier, rising butt hinges (which are different from the self-closing device mentioned above) are acceptable."""@en ;
    rdfs:subClassOf ficr:Closing .

ficr:Sensor a owl:Class ;
    rdfs:label "Sensor"@en ;
    rdfs:comment "A sensor in a building is a device that detects environmental changes and sends data to a control system to manage building functions like lighting, HVAC, and safety."@en ;
    rdfs:subClassOf ficr:Equipment .

ficr:SensorEvidence a owl:Class ;
    rdfs:label "SensorEvidence"@en ;
    rdfs:comment "An evidence item generated by a sensor or monitoring device to support an assessment finding or record."@en ;
    rdfs:subClassOf ficr:EvidenceItem .

ficr:ServiceShaft a owl:Class ;
    rdfs:label "ServiceShaft"@en ;
    rdfs:comment "A service shaft is a vertical passage in a building that houses pipes, cables, and ducts for essential building systems like water, electricity, and ventilation."@en ;
    rdfs:subClassOf ficr:ShaftSpace .

ficr:SolarShadingDevice a owl:Class ;
    rdfs:label "SolarShadingDevice"@en ;
    rdfs:comment "A device attached to the external surface of an external wall for reducing heat gain within a building by shading or deflecting sunlight."@en ;
    rdfs:subClassOf ficr:SpecifiedAttachment .

ficr:TestEvidence a owl:Class ;
    rdfs:label "TestEvidence"@en ;
    rdfs:comment "An evidence item generated by a test or measurement activity to support an assessment finding or record."@en ;
    rdfs:subClassOf ficr:EvidenceItem .

ficr:aboutElement a owl:ObjectProperty ;
    rdfs:label "aboutElement"@en ;
    rdfs:comment "Links a boundary condition record to the physical object whose fire-related boundary or performance condition it concerns."@en ;
    rdfs:domain ficr:BoundaryConditionRecord ;
    rdfs:range ficr:PhysicalObject .

ficr:according_to a owl:AnnotationProperty .

ficr:appliesToElementType a owl:ObjectProperty ;
    rdfs:label "appliesToElementType"@en ;
    rdfs:comment "Specifies the class of physical element this requirement applies to, e.g. ficr:Wall or ficr:Floor."@en ;
    rdfs:domain ficr:RegulatoryRequirement .

ficr:appliesToPurposeGroup a owl:ObjectProperty ;
    rdfs:label "appliesToPurposeGroup"@en ;
    rdfs:comment "Specifies the building purpose group for which this requirement is applicable."@en ;
    rdfs:domain ficr:RegulatoryRequirement ;
    rdfs:range ficr:PurposeGroup .

ficr:appliesToRiskUnit a owl:ObjectProperty ;
    rdfs:label "appliesToRiskUnit"@en ;
    rdfs:comment "Links a boundary condition record to the risk unit whose fire risk interpretation it informs."@en ;
    rdfs:domain ficr:BoundaryConditionRecord ;
    rdfs:range ficr:RiskUnit .

ficr:assessesElement a owl:ObjectProperty ;
    rdfs:label "assessesElement"@en ;
    rdfs:comment "Links an assessment to the physical element(s) it evaluates. For compliance assessments, this is the wall, door, or floor being checked. For risk assessments, this covers elements involved in fire spread modelling."@en ;
    rdfs:domain ficr:Assessment ;
    rdfs:range ficr:PhysicalObject .

ficr:assessesZone a owl:ObjectProperty ;
    rdfs:label "assessesZone"@en ;
    rdfs:comment "Links an assessment to the zone(s) or space(s) it covers. For risk assessments, this is the space whose fire scenario is being evaluated. For compliance assessments, this is the space containing the assessed elements."@en ;
    rdfs:domain ficr:Assessment ;
    rdfs:range bot:Zone .

ficr:checksRequirement a owl:ObjectProperty ;
    rdfs:label "checksRequirement"@en ;
    rdfs:comment "Links a compliance finding to the regulatory requirement being checked."@en ;
    rdfs:domain ficr:ComplianceFinding ;
    rdfs:range ficr:RegulatoryRequirement .

ficr:concernsElement a owl:ObjectProperty ;
    rdfs:label "concernsElement"@en ;
    rdfs:comment "Links an assessment finding to the physical object it concerns."@en ;
    rdfs:domain ficr:AssessmentFinding ;
    rdfs:range ficr:PhysicalObject .

ficr:concernsRiskUnit a owl:ObjectProperty ;
    rdfs:label "concernsRiskUnit"@en ;
    rdfs:comment "Links an assessment finding to the risk unit it concerns."@en ;
    rdfs:domain ficr:AssessmentFinding ;
    rdfs:range ficr:RiskUnit .

ficr:concernsSystem a owl:ObjectProperty ;
    rdfs:label "concernsSystem"@en ;
    rdfs:comment "Links an assessment finding to the building system it concerns."@en ;
    rdfs:domain ficr:AssessmentFinding ;
    rdfs:range ficr:BuildingSystem .

ficr:concernsZone a owl:ObjectProperty ;
    rdfs:label "concernsZone"@en ;
    rdfs:comment "Links an assessment finding to the spatial zone or space it concerns."@en ;
    rdfs:domain ficr:AssessmentFinding ;
    rdfs:range bot:Zone .

ficr:coversSpatialZone a owl:ObjectProperty ;
    rdfs:label "coversSpatialZone"@en ;
    rdfs:comment "Links a risk unit to the spatial zone whose fire exposure it aggregates."@en ;
    rdfs:domain ficr:RiskUnit ;
    rdfs:range bot:Zone .

ficr:dependsOnBoundaryCondition a owl:ObjectProperty ;
    rdfs:label "dependsOnBoundaryCondition"@en ;
    rdfs:comment "Links a fire risk scenario to boundary condition records or assumptions that influence the scenario interpretation."@en ;
    rdfs:domain ficr:FireRiskScenario ;
    rdfs:range ficr:BoundaryConditionRecord .

ficr:derivedFromRegulatorySource a owl:ObjectProperty ;
    rdfs:label "derivedFromRegulatorySource"@en ;
    rdfs:comment "Links a regulatory requirement individual to the regulatory, standard, or guidance source from which it was derived."@en ;
    rdfs:domain ficr:RegulatoryRequirement ;
    rdfs:range ficr:RegulatorySource .

ficr:derivedFromScenario a owl:ObjectProperty ;
    rdfs:label "derivedFromScenario"@en ;
    rdfs:comment "Links a risk finding to the fire risk scenario from which it was derived, enabling finding-level traceability when one risk analysis evaluates multiple scenarios."@en ;
    rdfs:domain ficr:RiskFinding ;
    rdfs:range ficr:FireRiskScenario .

ficr:documentTitle a owl:DatatypeProperty ;
    rdfs:label "documentTitle"@en ;
    rdfs:comment "A human-readable title used to display the document in user interfaces."@en ;
    rdfs:domain ficr:AssessmentBasis ;
    rdfs:range xsd:string .

ficr:documentURI a owl:DatatypeProperty ;
    rdfs:label "documentURI"@en ;
    rdfs:comment "A resolvable URI or file path pointing to the document location for human access."@en ;
    rdfs:domain ficr:AssessmentBasis ;
    rdfs:range xsd:anyURI .

ficr:hasActualREI a owl:DatatypeProperty ;
    rdfs:label "hasActualREI"@en ;
    rdfs:comment "The actual measured fire resistance period (R=load-bearing, E=integrity, I=insulation) in minutes."@en ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

ficr:hasApplicabilityState a owl:ObjectProperty ;
    rdfs:label "hasApplicabilityState"@en ;
    rdfs:comment "Records whether an assessment finding or checklist item is applicable, not applicable, or not assessed in the current assessment scope."@en ;
    rdfs:domain ficr:AssessmentFinding ;
    rdfs:range ficr:ApplicabilityState .

ficr:hasArea a owl:DatatypeProperty ;
    rdfs:label "hasArea"@en ;
    rdfs:comment "The floor area of a space in square metres."@en ;
    rdfs:range xsd:decimal .

ficr:hasAssessmentBasis a owl:ObjectProperty ;
    rdfs:label "hasAssessmentBasis"@en ;
    rdfs:comment "Links an assessment activity or assessment result to the evidence bundle that supports it."@en ;
    rdfs:domain ficr:Assessment ;
    rdfs:range ficr:AssessmentBasis .

ficr:hasBoundaryPerformanceAspect a owl:ObjectProperty ;
    rdfs:label "hasBoundaryPerformanceAspect"@en ;
    rdfs:comment "Identifies the boundary-related performance aspect assessed by a boundary condition record."@en ;
    rdfs:domain ficr:BoundaryConditionRecord ;
    rdfs:range ficr:BoundaryPerformanceAspect .

ficr:hasBuildingHeight a owl:DatatypeProperty ;
    rdfs:label "hasBuildingHeight"@en ;
    rdfs:comment "Height of a building is measured as shown in Appendix D, Diagram D4."@en ;
    rdfs:domain bot:Building ;
    rdfs:range xsd:decimal .

ficr:hasClauseReference a owl:DatatypeProperty ;
    rdfs:label "hasClauseReference"@en ;
    rdfs:comment "Records the clause, table, paragraph, section, or provision reference from which a regulatory requirement was derived."@en ;
    rdfs:domain ficr:RegulatoryRequirement ;
    rdfs:range xsd:string .

ficr:hasCombinedGrossFloorArea a owl:DatatypeProperty ;
    rdfs:label "hasCombinedGrossFloorArea"@en ;
    rdfs:comment "Total gross floor area of all storeys in a building, in square metres."@en ;
    rdfs:domain bot:Building ;
    rdfs:range xsd:decimal .

ficr:hasComplianceResult a owl:ObjectProperty ;
    rdfs:label "hasComplianceResult"@en ;
    rdfs:comment "Links a compliance finding to its compliance result."@en ;
    rdfs:domain ficr:ComplianceFinding ;
    rdfs:range ficr:ComplianceResult .

ficr:hasComponent a owl:ObjectProperty ;
    rdfs:label "hasComponent"@en ;
    rdfs:comment "Expressing the compositional relationship of components"@en ;
    rdfs:domain ficr:BuildingSystem ;
    rdfs:range ficr:PhysicalObject ;
    owl:inverseOf ficr:isComponentOf .

ficr:hasConditionState a owl:ObjectProperty ;
    rdfs:label "hasConditionState"@en ;
    rdfs:comment "Links a boundary condition record to its assessed condition state, such as effective, compromised, or unknown."@en ;
    rdfs:domain ficr:BoundaryConditionRecord ;
    rdfs:range ficr:ConditionState .

ficr:hasConnectionWith a owl:ObjectProperty ;
    rdfs:label "hasConnectionWith"@en ;
    rdfs:comment "indicates that the two individuals have a passageway."@en .

ficr:hasCoverageType a owl:DatatypeProperty ;
    rdfs:label "hasCoverageType"@en ;
    rdfs:comment "The spatial coverage mode of the detector, e.g. PointDetector, BeamDetector, AspiratingDetector."@en ;
    rdfs:domain ficr:Alarm ;
    rdfs:range xsd:string .

ficr:hasDetectionType a owl:DatatypeProperty ;
    rdfs:label "hasDetectionType"@en ;
    rdfs:comment "The detection principle of the alarm device, e.g. OpticalSmoke, Ionisation, Heat, MultiSensor, CarbonMonoxide."@en ;
    rdfs:domain ficr:Alarm ;
    rdfs:range xsd:string .

ficr:hasDirectDistance a owl:DatatypeProperty ;
    rdfs:label "hasDirectDistance"@en ;
    rdfs:comment "The shortest distance from any point within the floor area to the nearest storey exit, measured within the external enclosures of the building, and ignoring walls, partitions and fittings other than the enclosing walls and partitions to protected stairways."@en ;
    rdfs:range xsd:decimal .

ficr:hasElevation a owl:DatatypeProperty ;
    rdfs:label "hasElevation"@en ;
    rdfs:comment "The vertical height of a storey floor level above a reference datum, in metres."@en ;
    rdfs:range xsd:decimal .

ficr:hasEvidenceStatus a owl:ObjectProperty ;
    rdfs:label "hasEvidenceStatus"@en ;
    rdfs:comment "Links an assessment finding, boundary condition record, or other assessment-related record to a controlled evidence status. The domain is intentionally left open to avoid forcing all evidence-qualified records into the AssessmentFinding hierarchy."@en ;
    rdfs:range ficr:EvidenceStatus .

ficr:hasExtinguisherAgent a owl:DatatypeProperty ;
    rdfs:label "hasExtinguisherAgent"@en ;
    rdfs:comment "The extinguishing agent type, e.g. DryPowder, CO2, WaterMist, WetChemical, Foam."@en ;
    rdfs:domain ficr:FireExtinguisher ;
    rdfs:range xsd:string .

ficr:hasFindingStatement a owl:DatatypeProperty ;
    rdfs:label "hasFindingStatement"@en ;
    rdfs:comment "A human-readable statement of what the finding records. Used for expected-vs-actual validation tables and reporting."@en ;
    rdfs:domain ficr:AssessmentFinding ;
    rdfs:range xsd:string .

ficr:hasFireClassRating a owl:DatatypeProperty ;
    rdfs:label "hasFireClassRating"@en ;
    rdfs:comment "The fire class rating per BS EN 2, e.g. A, B, AB, ABC, AF."@en ;
    rdfs:domain ficr:FireExtinguisher ;
    rdfs:range xsd:string .

ficr:hasFixedAssetValue a owl:DatatypeProperty ;
    rdfs:label "hasFixedAssetValue"@en ;
    rdfs:comment "This refers to the total asset value of the space."@en ;
    rdfs:range xsd:decimal .

ficr:hasID a owl:DatatypeProperty ;
    rdfs:label "hasID"@en ;
    rdfs:comment "A unique identifier string for the entity."@en ;
    rdfs:range xsd:string .

ficr:hasImpairmentState a owl:ObjectProperty ;
    rdfs:label "hasImpairmentState"@en ;
    rdfs:comment "Links an asset, system, provision, or relevant physical object to its operational impairment state. The domain is intentionally left open because impairment may apply to fire-protection provisions, general equipment, building systems, or other inspected assets."@en ;
    rdfs:range ficr:ImpairmentState .

ficr:hasInstallationStatus a owl:ObjectProperty ;
    rdfs:label "hasInstallationStatus"@en ;
    rdfs:comment "Links an asset, system, provision, or relevant physical object to its installation status. The domain is intentionally left open because installation status may apply to fire-protection provisions, general equipment, and building systems."@en ;
    rdfs:range ficr:InstallationStatus .

ficr:hasJurisdiction a owl:DatatypeProperty ;
    rdfs:label "hasJurisdiction"@en ;
    rdfs:comment "Specifies the jurisdiction in which a regulatory source, requirement, or assessment context applies."@en ;
    rdfs:domain ficr:RegulatorySource ;
    rdfs:range xsd:string .

ficr:hasLength a owl:DatatypeProperty ;
    rdfs:label "hasLength"@en ;
    rdfs:comment "The length dimension of a building element, in metres."@en ;
    rdfs:range xsd:decimal .

ficr:hasNumberOfStoreys a owl:DatatypeProperty ;
    rdfs:label "hasNumberOfStoreys"@en ;
    rdfs:comment "Number of storeys excluding basements"@en ;
    rdfs:domain bot:Building ;
    rdfs:range xsd:integer .

ficr:hasOriginSpace a owl:ObjectProperty ;
    rdfs:label "hasOriginSpace"@en ;
    rdfs:comment "Links a fire risk scenario to the zone where the fire is modelled to originate."@en ;
    rdfs:domain ficr:FireRiskScenario ;
    rdfs:range bot:Zone .

ficr:hasPurposeGroup a owl:ObjectProperty ;
    rdfs:label "hasPurposeGroup"@en ;
    rdfs:comment "Relates a building to its functional purpose group classification according to ADB Table 0.1"@en ;
    rdfs:domain bot:Building ;
    rdfs:range ficr:PurposeGroup ;
    rdfs:subPropertyOf ficr:hasClassification ;
    owl:inverseOf ficr:isPurposeGroupOf .

ficr:hasRequiredREI a owl:DatatypeProperty ;
    rdfs:label "hasRequiredREI"@en ;
    rdfs:comment "The minimum REI value mandated by regulation for a given element type and purpose group, in minutes."@en ;
    rdfs:domain ficr:RegulatoryRequirement ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf owl:topDataProperty .

ficr:hasScenario a owl:ObjectProperty ;
    rdfs:label "hasScenario"@en ;
    rdfs:comment "Links a risk analysis to the fire risk scenario or scenarios it evaluates. Each scenario represents a hypothetical fire origin and relevant spread or exposure context used for risk-informed interpretation."@en ;
    rdfs:domain ficr:RiskAnalysis ;
    rdfs:range ficr:FireRiskScenario .

ficr:hasScenarioDescription a owl:DatatypeProperty ;
    rdfs:label "hasScenarioDescription"@en ;
    rdfs:comment "Provides a narrative description of the fire risk scenario, including where the fire is assumed to originate, how it may spread, and why it is expected to stop or be limited."@en ;
    rdfs:domain ficr:FireRiskScenario ;
    rdfs:range xsd:string .

ficr:hasScenarioRiskUnit a owl:ObjectProperty ;
    rdfs:label "hasScenarioRiskUnit"@en ;
    rdfs:comment "Links a fire risk scenario to the risk unit whose fire risk is being interpreted."@en ;
    rdfs:domain ficr:FireRiskScenario ;
    rdfs:range ficr:RiskUnit .

ficr:hasServiceExpiryDate a owl:DatatypeProperty ;
    rdfs:label "hasServiceExpiryDate"@en ;
    rdfs:comment "The date by which the equipment must be serviced or replaced to remain compliant."@en ;
    rdfs:domain ficr:Equipment ;
    rdfs:range xsd:date .

ficr:hasSourceEdition a owl:DatatypeProperty ;
    rdfs:label "hasSourceEdition"@en ;
    rdfs:comment "Records the edition, year, version, or publication date of a regulatory, standards, or guidance source."@en ;
    rdfs:domain ficr:RegulatorySource ;
    rdfs:range xsd:string .

ficr:hasSourcePublisher a owl:DatatypeProperty ;
    rdfs:label "hasSourcePublisher"@en ;
    rdfs:comment "Records the issuing body or publisher of a regulatory, standards, or guidance source."@en ;
    rdfs:domain ficr:RegulatorySource ;
    rdfs:range xsd:string .

ficr:hasStoreyHeight a owl:DatatypeProperty ;
    rdfs:label "hasStoreyHeight"@en ;
    rdfs:comment "The floor-to-floor height of a storey, in metres."@en ;
    rdfs:range xsd:decimal .

ficr:hasThickness a owl:DatatypeProperty ;
    rdfs:label "hasThickness"@en ;
    rdfs:comment "The thickness dimension of a building element, in metres."@en ;
    rdfs:range xsd:decimal .

ficr:hasTopStoreyFloorHeight a owl:DatatypeProperty ;
    rdfs:label "hasTopStoreyFloorHeight"@en ;
    rdfs:comment "Height of the floor of the top storey above ground level is measured as shown in Appendix D, Diagram D6."@en ;
    rdfs:domain bot:Building ;
    rdfs:range xsd:decimal .

ficr:hasTopStoreyHeight a owl:DatatypeProperty ;
    rdfs:label "hasTopStoreyHeight"@en ;
    rdfs:comment "The floor-to-ceiling height of the topmost storey, in metres."@en ;
    rdfs:domain bot:Building ;
    rdfs:range xsd:decimal .

ficr:hasTravelDistance a owl:DatatypeProperty ;
    rdfs:label "hasTravelDistance"@en ;
    rdfs:comment "(unless otherwise specified, e.g. as in the case of flats) The distance that a person would travel from any point within the floor area to the nearest storey exit, determined by the layout of walls, partitions and fittings."@en ;
    rdfs:range xsd:decimal .

ficr:hasUtilizationPurpose a owl:ObjectProperty ;
    rdfs:label "hasUtilizationPurpose"@en ;
    rdfs:comment "Assigns a building planning utilization purpose (e.g. Hotel, Office) to a zone or building."@en ;
    rdfs:domain bot:Building ;
    rdfs:range ficr:UtilizationPurpose ;
    rdfs:subPropertyOf ficr:hasUsageType ;
    owl:inverseOf ficr:isUtilizationPurposeOf .

ficr:hasVolume a owl:DatatypeProperty ;
    rdfs:label "hasVolume"@en ;
    rdfs:comment "The volume of a space, in cubic metres."@en ;
    rdfs:range xsd:decimal .

ficr:hasWidth a owl:DatatypeProperty ;
    rdfs:label "hasWidth"@en ;
    rdfs:comment "The width dimension of a building element, in metres."@en ;
    rdfs:range xsd:decimal .

ficr:isDamaged a owl:DatatypeProperty ;
    rdfs:label "isDamaged"@en ;
    rdfs:comment "Boolean indicating whether the element shows visible damage affecting its fire performance."@en ;
    rdfs:range xsd:boolean .

ficr:isEnclosed a owl:DatatypeProperty ;
    rdfs:label "isEnclosed"@en ;
    rdfs:comment "Boolean indicating whether the element or space is fully enclosed by construction."@en ;
    rdfs:range xsd:boolean .

ficr:isExposedTo a owl:ObjectProperty ;
    rdfs:label "isExposedTo"@en ;
    rdfs:comment "Indicates potential fire spread exposure between risk units."@en ;
    rdfs:domain ficr:RiskUnit ;
    rdfs:range ficr:RiskUnit .

ficr:isLoadBearing a owl:DatatypeProperty ;
    rdfs:label "isLoadBearing"@en ;
    rdfs:comment "Boolean indicating whether the element carries structural loads."@en ;
    rdfs:range xsd:boolean .

ficr:isLocatedIn a owl:ObjectProperty ;
    rdfs:label "isLocatedIn"@en ;
    rdfs:comment "describe the location and/or surroundings of a place."@en ;
    rdfs:domain ficr:PhysicalObject ;
    rdfs:range bot:Zone .

ficr:isObscured a owl:DatatypeProperty ;
    rdfs:label "isObscured"@en ;
    rdfs:comment "Refers to the state of being obscured."@en ;
    rdfs:range xsd:boolean .

ficr:isStoreyAbove a owl:ObjectProperty ;
    rdfs:label "isStoreyAbove"@en ;
    rdfs:comment "Indicates that the subject storey is directly above the object storey."@en ;
    rdfs:domain bot:Storey ;
    rdfs:range bot:Storey .

ficr:isStoreyBelow a owl:ObjectProperty ;
    rdfs:label "isStoreyBelow"@en ;
    rdfs:comment "Indicates that the subject storey is directly below the object storey."@en ;
    rdfs:domain bot:Storey ;
    rdfs:range bot:Storey .

ficr:plannedEndTime a owl:DatatypeProperty ;
    rdfs:label "plannedEndTime"@en ;
    rdfs:comment "The scheduled end date and time of a task."@en ;
    rdfs:domain ficr:Task ;
    rdfs:range xsd:dateTime .

ficr:plannedStartTime a owl:DatatypeProperty ;
    rdfs:label "plannedStartTime"@en ;
    rdfs:comment "The scheduled start date and time of a task."@en ;
    rdfs:domain ficr:Task ;
    rdfs:range xsd:dateTime .

ficr:producesAssessment a owl:ObjectProperty ;
    rdfs:label "producesAssessment"@en ;
    rdfs:comment "Links a task to the assessment record produced by executing that task."@en ;
    rdfs:domain ficr:Task ;
    rdfs:range ficr:Assessment .

ficr:producesEvidence a owl:ObjectProperty ;
    rdfs:label "producesEvidence"@en ;
    rdfs:comment "Links a task to evidence items it generates."@en ;
    rdfs:domain ficr:Task ;
    rdfs:range ficr:EvidenceItem .

ficr:reliesOnBoundaryCondition a owl:ObjectProperty ;
    rdfs:label "reliesOnBoundaryCondition"@en ;
    rdfs:comment "Links an assessment to a boundary condition record that it relies on or interprets. This allows compliance checking and risk analysis to expose whether their conclusions depend on effective, compromised, unknown, or weakly evidenced boundary conditions."@en ;
    rdfs:domain ficr:Assessment ;
    rdfs:range ficr:BoundaryConditionRecord .

ficr:requiresInspection a owl:DatatypeProperty ;
    rdfs:label "requiresInspection"@en ;
    rdfs:comment "Must be subject to inspection assignments (e.g., fire safety inspections)."@en ;
    rdfs:range xsd:boolean .

ficr:supportedByEvidence a owl:ObjectProperty ;
    rdfs:label "supportedByEvidence"@en ;
    rdfs:comment "Links an assessment finding, boundary condition record, or other assessment-related record to evidence items that support, justify, or document it. The domain is intentionally left open because evidence support is used both for produced findings and for assessment dependencies such as boundary condition records."@en ;
    rdfs:range ficr:EvidenceItem .

ficr:triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggeredBy"@en ;
    rdfs:comment "A task is created because an event (e.g., risk detected) occurred."@en ;
    rdfs:domain ficr:Task ;
    rdfs:range ficr:Event ;
    owl:inverseOf ficr:triggersTask .

ficr:usesComplianceFinding a owl:ObjectProperty ;
    rdfs:label "usesComplianceFinding"@en ;
    rdfs:comment "Links a risk analysis to compliance findings used as inputs for risk interpretation."@en ;
    rdfs:domain ficr:RiskAnalysis ;
    rdfs:range ficr:ComplianceFinding .

ficr:usesEvidence a owl:ObjectProperty ;
    rdfs:label "usesEvidence"@en ;
    rdfs:comment "Links a task to evidence items it consumes as inputs."@en ;
    rdfs:domain ficr:Task ;
    rdfs:range ficr:EvidenceItem .

