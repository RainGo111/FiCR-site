bot:adjacentZone a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "zona adjacent"@ca,
        "přilehlá zóna"@cs,
        "tilstødende zone"@da,
        "angrenzende Zone"@de,
        "adjacent zone"@en,
        "zona adyacente"@es,
        "منطقه همجوار"@fa,
        "viereinen vyöhyke"@fi,
        "zone adjacente"@fr,
        "zona adiacente"@it,
        "aangrenzende zone"@nl,
        "zona adjacente"@pt,
        "priľahlá zóna"@sk,
        "angränsande zon"@sv,
        "Bitisik bölge"@tr,
        "相邻区域"@zh-cn ;
    rdfs:comment "Relació entre dues zones que comparteixen una interfície comuna, però que no interseccionen"@ca,
        "Vztah mezi dvěmi zónami, které se dotýkají, ale neprotínají se."@cs,
        "Relation mellem to zoner, der deler en fælles grænseflade."@da,
        "Beziehung zwischen zwei Zonen die eine gemeinsame Grenzfläche haben, aber sich nicht schneiden."@de,
        "Relationship between two zones that share a common interface, but do not intersect."@en,
        "Relación entre dos zonas que comparten una interfaz común, pero que no intersecan."@es,
        "رابطه بین دو منطقه که یک رابط مشترک دارند، ولی منقطع نیستند."@fa,
        "Suhde kahden vyöhykkeen välillä, jotka jakavat yhteisen rajapinnan mutta eivät leikkaa toisiaan."@fi,
        "Relation entre deux zones partageant une interface commune, sans intersection"@fr,
        "Relazione tra due zone che condividono un'interfaccia senza però intersecarsi."@it,
        "Relatie tussen twee zones die een interface delen, maar niet doorsnijdend zijn"@nl,
        "Relação entre duas zonas que partilham um interface comum mas que não se intersectam."@pt,
        "Vzťah medzi dvomi zónami, ktoré sa dotýkajú, ale nepretínajú sa."@sk,
        "Relation mellan två zoner som delar ett gemensamt gränssnitt men som inte korsar varandra."@sv,
        "Ortak bir arayüzü paylaşan iki bölge arasındaki bağlantı."@tr,
        "两个区域之间共享公共界面但不相交的关系"@zh-cn ;
    rdfs:domain bot:Zone ;
    rdfs:isDefinedBy bot: ;
    rdfs:range bot:Zone ;
    owl:propertyDisjointWith bot:intersectsZone ;
    vs:term_status "stable" ;
    schema:domainIncludes bot:Building,
        bot:Site,
        bot:Space,
        bot:Storey ;
    schema:rangeIncludes bot:Building,
        bot:Site,
        bot:Space,
        bot:Storey .

bot:intersectingElement a owl:ObjectProperty ;
    rdfs:label "element d'intersecció"@ca,
        "protíná element-prvek"@cs,
        "krydsende Bygningsdel"@da,
        "schneidendes Bauteil"@de,
        "intersecting element"@en,
        "elemento de intersección"@es,
        "المان متلاقی"@fa,
        "leikkaava elementti"@fi,
        "élément intersectant"@fr,
        "elemento intersecante"@it,
        "doorsnijdend element"@nl,
        "elemento intersectante"@pt,
        "pretína element-prvok"@sk,
        "korsande byggdel"@sv,
        "Eleman ile temas"@tr,
        "相交构件"@zh-cn ;
    rdfs:comment "Relació entre una zona i un element constructiu que la intersecta."@ca,
        "Vztah mezi zónou a stavebním prvkem, který ji protíná."@cs,
        "Forholdet mellem en zone og et bygningselement, der krydser det."@da,
        "Beziehung zwischen einer Zone und einem Bauteil, das die Zone schneidet."@de,
        "Relation between a Zone and a building Element that intersects it."@en,
        "Relación entre una zona y un elemento constructivo que la interseca."@es,
        "رابطه بین یک منطقه با المان ساختمانی که با آن در تلاقی است."@fa,
        "Suhde vyöhykkeen ja sitä leikkaavan rakennuselementin välillä."@fi,
        "Relation entre une zone et un élément du bâtiment qui la traverse."@fr,
        "Relazione tra una zona e un elemento di costruzione che la interseca."@it,
        "Relatie tussen een zone en een gebouwelement die de zone doorsnijdt."@nl,
        "Relação entre uma Zona e um Elemento construtivo que a intersecta."@pt,
        "Vzťah medzi zónou a stavebným prvkom, ktorý ju pretína."@sk,
        "Relationen mellan en zon och en byggdel som korsar zonen."@sv,
        "Bir Bölge ve onunla kesişen bir yapı Elemanı arasındaki ilişki."@tr,
        "区域中相交建筑构件之间的关系。"@zh-cn ;
    rdfs:isDefinedBy bot: ;
    rdfs:subPropertyOf bot:hasElement ;
    owl:propertyDisjointWith bot:adjacentElement ;
    vs:term_status "stable" .

bot:intersectsZone a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "interseca amb zona"@ca,
        "protíná zónu"@cs,
        "skærer zone"@da,
        "sich schneidende Zone"@de,
        "intersects zone"@en,
        "interseca con zona"@es,
        "منطقه متلاقی"@fa,
        "leikkaa vyöhykettä"@fi,
        "intersecte zone"@fr,
        "interseca zona"@it,
        "snijdt door zone"@nl,
        "intersecta zona"@pt,
        "pretína zónu"@sk,
        "skär zon"@sv,
        "Bölge ile temas"@tr,
        "相交区域"@zh-cn ;
    rdfs:comment "Relació entre dues zones l'extensió fa que una interseccioni amb l'altra. Per exemple, una escala creua diferents pisos."@ca,
        "Vztah dvou zón, které se protínají svým prostorovým ohraničením. Na příklad, eskalátor protíná vícero podlažních zón."@cs,
        "Forholdet mellem to zoner, hvis 3D-omfang skærer hinanden. For eksempel skærer et trappehus forskellige etager."@da,
        "Beziehung zwischen zwei Zonen, die sich schneiden. Zum Beispiel schneidet eine Treppe verschiedene Geschosse."@de,
        "Relationship between two zones whose 3D extent intersect. For example, a stairwell intersects different storeys."@en,
        "Relación entre dos zonas cuya extensión hace que una interseccione con la otra. Por ejemplo, una escalera cruza diferentes pisos."@es,
        "رابطه بین دو منطقه که حدود سه بعدی آنها با هم تلاقی دارد. برای مثال، یک راه پله از منطقه های مختلف عبور می کند و با آنها تلاقی دارد."@fa,
        "Suhde kahden vyöhykkeen välillä, jotka leikkaavat toisiaan. Esimerkiksi rappuset leikkaavat useita kerroksia."@fi,
        "Relation entre deux zones dont l'étendue 3D se croise. Par exemple, une cage d'escalier croise différents étages."@fr,
        "Relazione tra due zone le cui estensioni 3D si intersecano. Per esempio, una tromba delle scale interseca vari piani."@it,
        "Een relatie tussen twee zones waarvan de driedimensionale omvang doorsnijdend is. Bijvoorbeeld een traphal die verschillende verdiepingen doorsnijdt."@nl,
        "Relação entre duas zonas cuja extensão tridimensional se intersecta. Por exemplo, uma caixa de escadas intersecta vários pisos."@pt,
        "Vzťach dvoch zón, ktoré sa pretínajú svojim priestorovým rozhraním. Príkladom môže byť eskalátor prestupujúci cez vac zón-podlaží."@sk,
        "Relationen mellan två zoner vars tredimensionella utsträckning korsar varandra. Till exempel, ett trapphus som skär igenom flera våningar."@sv,
        "3D kapsamı kesişen iki bölge arasındaki ilişki. Örneğin, bir merdiven boşluğu farklı katlarla kesişir."@tr,
        "两个区域之间三维空间相交的关系。 例如，楼梯间与不同楼层的相交"@zh-cn ;
    rdfs:domain bot:Zone ;
    rdfs:isDefinedBy bot: ;
    rdfs:range bot:Zone ;
    owl:propertyDisjointWith bot:adjacentZone ;
    vs:term_status "stable" ;
    schema:domainIncludes bot:Building,
        bot:Site,
        bot:Space,
        bot:Storey ;
    schema:rangeIncludes bot:Building,
        bot:Site,
        bot:Space,
        bot:Storey .

<https://w3id.org/ficr> a owl:Ontology ;
    dcterms:creator "Craig Hancock",
        "Dayou Chen",
        "Long Chen",
        "Qiuchen Lu",
        "Simon Sølvsten",
        "Yu Zhang" ;
    dcterms:description "FiCR, Fire Compliance and Risk Analysis, is a domain specific semantic model designed to represent fire safety and fire risk relevant physical objects, building elements, equipment, functional roles, and their relationships in existing buildings. It supports a structured and interoperable representation of both passive and active fire protection measures, as well as risk related attributes and performance outcomes, enabling compliance assessment, fire risk analysis, and inspection activities throughout the building operation and maintenance phase. FiCR further provides a semantic foundation for rule based reasoning and fire oriented digital twins that integrate regulatory compliance and risk informed decision making."@en ;
    dcterms:issued "2025-06-26"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2025-07-10"^^xsd:date ;
    dcterms:title "FiCR: Fire Compliance and Risk Analysis Ontology"@en ;
    vann:preferredNamespacePrefix "ficr" ;
    vann:preferredNamespaceUri "https://w3id.org/ficr#" ;
    rdfs:comment "FiCR, Fire Compliance and Risk Analysis Ontology"@en,
        "Property domain convention: properties shared by multiple record types (e.g. supportedByEvidence, hasEvidenceStatus, measurement properties such as hasActualREI) are deliberately declared without rdfs:domain to avoid unintended type inference. Properties with a single host class declare an explicit rdfs:domain. Intended subjects are documented in each property's rdfs:comment."@en ;
    owl:priorVersion <https://w3id.org/ficr/1.1.0> ;
    owl:versionIRI <https://w3id.org/ficr/1.1.1> ;
    owl:versionInfo "1.1.1" .

ficr:AccessRoomRole a owl:Class,
        owl:NamedIndividual,
        ficr:AccessRoomRole,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "AccessRoomRole"@en ;
    rdfs:comment "Access role refers to the room that the only escape route from an inner room passes through."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:Accommodation a owl:Class,
        owl:NamedIndividual,
        ficr:Accommodation,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Accommodation"@en ;
    rdfs:comment "A utilization purpose for premises providing temporary or permanent residential living."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:AlternativeEscapeRouteRole a owl:Class,
        owl:NamedIndividual,
        ficr:AlternativeEscapeRouteRole,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "AlternativeEscapeRouteRole"@en ;
    rdfs:comment """Escape routes that are sufficiently separated by direction and space or by fire resisting construction to ensure that one is still available if the other is affected by fire.\r
A second stair, balcony or flat roof which enables a person to reach a place free from danger from fire is considered an alternative escape route for the purposes of a dwellinghouse."""@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:AlternativeExitRole a owl:Class,
        owl:NamedIndividual,
        ficr:AlternativeExitRole,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "AlternativeExitRole"@en ;
    rdfs:comment "One of two or more exits, each of which is separate from the other."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:Applicable a owl:Class,
        owl:NamedIndividual,
        ficr:ApplicabilityState,
        ficr:Applicable,
        ficr:AssessmentState ;
    rdfs:label "Applicable"@en ;
    rdfs:comment "An applicability state indicating that the requirement, rule, or assessment condition applies in the given context."@en ;
    rdfs:subClassOf ficr:ApplicabilityState ;
    owl:disjointWith ficr:NotApplicable,
        ficr:NotAssessed .

ficr:AssemblyPlace a owl:Class,
        owl:NamedIndividual,
        ficr:AssemblyPlace,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "AssemblyPlace"@en ;
    rdfs:comment "A utilization purpose for premises used for public assembly, entertainment, or recreation."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:Auditorium a owl:Class,
        owl:NamedIndividual,
        ficr:Auditorium,
        ficr:SpaceUsage,
        ficr:UsageType ;
    rdfs:label "Auditorium"@en ;
    rdfs:comment "An auditorium is a large room or building designed for public gatherings, such as performances, lectures, or meetings."@en ;
    rdfs:subClassOf ficr:SpaceUsage ;
    owl:disjointWith ficr:Bathroom,
        ficr:CirculationUsage,
        ficr:Gallery,
        ficr:HabitableRoom,
        ficr:Kitchen,
        ficr:PlaceOfSpecialHazard,
        ficr:ServiceUsage,
        ficr:Warehouse .

ficr:BalconySpace a owl:Class ;
    rdfs:label "BalconySpace"@en ;
    rdfs:comment "A balcony is a platform projecting from the wall of a building, enclosed by a balustrade or railing, and accessed from an upper-level room."@en ;
    rdfs:subClassOf bot:Space ;
    owl:disjointWith ficr:CavitySpace,
        ficr:DuctSpace,
        ficr:RoofSpace,
        ficr:RoomSpace,
        ficr:ShaftSpace,
        ficr:StairSpace .

ficr:BasementStorey a owl:Class ;
    rdfs:label "BasementStorey"@en ;
    rdfs:comment "A storey with a floor that, at some point, is more than 1200mm below the highest level of ground beside the outside walls. (However, see Appendix B, paragraph B26c, for situations where the storey is considered to be a basement only because of a sloping site.)"@en ;
    rdfs:subClassOf bot:Storey ;
    owl:disjointWith ficr:GroundAndAboveStorey ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bot:Storey [ a owl:Restriction ;
                        owl:hasValue false ;
                        owl:onProperty ficr:isAboveGround ] ) ] .

ficr:BoardingHouse a owl:Class,
        owl:NamedIndividual,
        ficr:BoardingHouse,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "BoardingHouse"@en ;
    rdfs:comment "A utilization purpose for premises providing lodging and meals for paying guests."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:BoilerRoom a owl:Class,
        owl:NamedIndividual,
        ficr:BoilerRoom,
        ficr:PlaceOfSpecialHazard,
        ficr:SpaceUsage,
        ficr:UsageType ;
    rdfs:label "BoilerRoom"@en ;
    rdfs:comment "A boiler room is a dedicated space in a building that houses essential mechanical equipment for services like heating, hot water, and electricity"@en ;
    rdfs:subClassOf ficr:PlaceOfSpecialHazard ;
    owl:disjointWith ficr:EngineRoom,
        ficr:FuelStorage,
        ficr:SwitchGearRoom,
        ficr:TransformerRoom .

ficr:CarParking a owl:Class,
        owl:NamedIndividual,
        ficr:CarParking,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "CarParking"@en ;
    rdfs:comment "A utilization purpose for premises designed for vehicle parking and storage."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:CertificateEvidence a owl:Class ;
    rdfs:label "CertificateEvidence"@en ;
    rdfs:comment "A document evidence item representing a certificate that supports an assessment finding or record."@en ;
    rdfs:subClassOf ficr:DocumentEvidence .

ficr:CirculationSpaceRole a owl:Class,
        owl:NamedIndividual,
        ficr:CirculationSpaceRole,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "CirculationSpaceRole"@en ;
    rdfs:comment "Circulation space refers to a space (including a protected stairway) mainly used as a means of access between a room and an exit from the building or compartment."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:CommercialPlace a owl:Class,
        owl:NamedIndividual,
        ficr:CommercialPlace,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "CommercialPlace"@en ;
    rdfs:comment "A utilization purpose for premises used for commercial trading activities."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:CompartmentFloor a owl:Class ;
    rdfs:label "CompartmentFloor"@en ;
    rdfs:comment "A fire resisting floor to separate one fire compartment from another."@en ;
    rdfs:subClassOf ficr:FireProtectionElement,
        ficr:Floor ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:Floor [ a owl:Restriction ;
                        owl:onProperty ficr:hasPhysicalObjectFireSafetyRole ;
                        owl:someValuesFrom ficr:FireSeparatingRole ] ) ] .

ficr:ComplianceChecking a owl:Class ;
    rdfs:label "ComplianceChecking"@en ;
    rdfs:comment "An assessment that checks whether fire-related requirements are satisfied. It produces compliance findings rather than storing a single assessment-level result."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ficr:ComplianceFinding ;
            owl:onProperty ficr:producesFinding ],
        ficr:Assessment .

ficr:ComplianceCheckingTask a owl:Class ;
    rdfs:label "ComplianceCheckingTask"@en ;
    rdfs:comment "A task that evaluates one or more requirements against available evidence and produces a compliance result."@en ;
    rdfs:subClassOf ficr:Task .

ficr:DeadEndRole a owl:Class,
        owl:NamedIndividual,
        ficr:DeadEndRole,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "DeadEndRole"@en ;
    rdfs:comment "An area from which escape is possible in one direction only."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:DetentionHouse a owl:Class,
        owl:NamedIndividual,
        ficr:DetentionHouse,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "DetentionHouse"@en ;
    rdfs:comment "A utilization purpose for premises used for lawful detention of persons."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:Dwellinghouse a owl:Class,
        owl:NamedIndividual,
        ficr:Dwellinghouse,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Dwellinghouse"@en ;
    rdfs:comment "Does not include a flat or a building containing a flat."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:ElectricalSystem a owl:Class ;
    rdfs:label "ElectricalSystem"@en ;
    rdfs:comment "An electrical system in a building is a network of wiring, equipment, and protective devices that safely distributes power from its entry point to all the loads, such as lights, outlets, and appliances, within the structure."@en ;
    rdfs:subClassOf ficr:BuildingSystem .

ficr:EmergencyLightingSystem a owl:Class ;
    rdfs:label "EmergencyLightingSystem"@en ;
    rdfs:comment "A protection system that provides lighting for escape routes, safety equipment, or relevant spaces when normal lighting fails."@en ;
    rdfs:subClassOf ficr:BuildingSystem .

ficr:EntertainmentPlace a owl:Class,
        owl:NamedIndividual,
        ficr:EntertainmentPlace,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "EntertainmentPlace"@en ;
    rdfs:comment "A utilization purpose for premises used for entertainment or recreational activities."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:EquipmentInspectionTask a owl:Class ;
    rdfs:label "EquipmentInspectionTask"@en ;
    rdfs:comment "Inspection task consumes observations produced by upstream tools."@en ;
    rdfs:subClassOf ficr:Task .

ficr:ExitPassagewayRole a owl:Class,
        owl:NamedIndividual,
        ficr:EscapeAndEvacuationRole,
        ficr:ExitPassagewayRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "ExitPassagewayRole"@en ;
    rdfs:comment "A protected passageway that connects a protected stairway to a final exit."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:Factory a owl:Class,
        owl:NamedIndividual,
        ficr:Factory,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Factory"@en ;
    rdfs:comment "Assumption that the external wall construction does not contribute to external fire spread between compartments or buildings."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:FinalExitRole a owl:Class,
        owl:NamedIndividual,
        ficr:EscapeAndEvacuationRole,
        ficr:FinalExitRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "FinalExitRole"@en ;
    rdfs:comment """The end of an escape route from a building that gives direct access to a street, passageway, walkway or open space, and is sited to ensure that people rapidly disperse away from the building so that they are no longer in danger from fire and/or smoke.\r
Windows are not acceptable as final exits."""@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:FireDamper a owl:Class ;
    rdfs:label "FireDamper"@en ;
    rdfs:comment "A mechanical or intumescent device within a duct or ventilation opening that operates automatically and is designed to resist the spread of fire."@en ;
    rdfs:subClassOf ficr:Closing,
        ficr:FireProtectionElement ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ficr:Closing [ a owl:Restriction ;
                        owl:onProperty ficr:hasPhysicalObjectFireSafetyRole ;
                        owl:someValuesFrom ficr:FireResistingRole ] ) ] .

ficr:FireRiskAssessmentTask a owl:Class ;
    rdfs:label "FireRiskAssessmentTask"@en ;
    rdfs:comment "A task that produces a fire risk analysis assessment for O&M use. It supports risk-informed interpretation by linking risk units, fire risk scenarios, compliance findings, boundary condition records, condition states, and evidence status."@en ;
    rdfs:subClassOf ficr:Task .

ficr:FireSafetySpace a owl:Class ;
    rdfs:label "FireSafetySpace"@en ;
    rdfs:comment "\"Fire safety space\" in a building refers to the areas designed to prevent the spread of fire and smoke and guide occupants to safety."@en ;
    rdfs:subClassOf bot:Zone .

ficr:Flat a owl:Class,
        owl:NamedIndividual,
        ficr:Flat,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Flat"@en ;
    rdfs:comment "A flat is a separate and self-contained premises constructed or adapted for use for residential purposes and forming part of a building from some other part of which it is divided horizontally."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:HVACSystem a owl:Class ;
    rdfs:label "HVACSystem"@en ;
    rdfs:comment "An HVAC system is a building's climate control system for heating, ventilation, and air conditioning."@en ;
    rdfs:subClassOf ficr:BuildingSystem .

ficr:HallOfResidence a owl:Class,
        owl:NamedIndividual,
        ficr:HallOfResidence,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "HallOfResidence"@en ;
    rdfs:comment "A utilization purpose for institutional residential accommodation, typically for students or workers."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:Hospital a owl:Class,
        owl:NamedIndividual,
        ficr:Hospital,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Hospital"@en ;
    rdfs:comment "A utilization purpose for premises providing medical treatment, care, or maintenance of persons."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:Hostel a owl:Class,
        owl:NamedIndividual,
        ficr:Hostel,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Hostel"@en ;
    rdfs:comment "A utilization purpose for premises providing basic shared accommodation."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:Hotel a owl:Class,
        owl:NamedIndividual,
        ficr:Hotel,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Hotel"@en ;
    rdfs:comment "A utilization purpose for premises providing temporary guest accommodation with services."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:InnerRoomRole a owl:Class,
        owl:NamedIndividual,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:InnerRoomRole,
        ficr:UsageType ;
    rdfs:label "InnerRoomRole"@en ;
    rdfs:comment "Inner room refers to Room from which escape is possible only by passing through another room (the access room)."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:InspectionAssessment a owl:Class ;
    rdfs:label "InspectionAssessment"@en ;
    rdfs:comment "An assessment activity that evaluates fire safety or compliance conditions through inspection."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ficr:InspectionFinding ;
            owl:onProperty ficr:producesFinding ],
        ficr:Assessment .

ficr:InstallationNotRequired a owl:Class,
        owl:NamedIndividual,
        ficr:AssessmentState,
        ficr:InstallationNotRequired,
        ficr:InstallationStatus ;
    rdfs:label "InstallationNotRequired"@en ;
    rdfs:comment "An installation status indicating that installation of the system or component is not required."@en ;
    rdfs:subClassOf ficr:InstallationStatus ;
    owl:disjointWith ficr:InstallationUnknown,
        ficr:Installed,
        ficr:NotInstalled,
        ficr:PartiallyInstalled .

ficr:MeansOfEscapeRole a owl:Class,
        owl:NamedIndividual,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:MeansOfEscapeRole,
        ficr:UsageType ;
    rdfs:label "MeansOfEscapeRole"@en ;
    rdfs:comment "Structural means that provide one or more safe routes for people to go, during a fire, from any point in the building to a place of safety."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:MultiStoreyBuilding a owl:Class ;
    rdfs:label "MultiStoreyBuilding"@en ;
    rdfs:comment """The building is regarded as a multi-storey building if both of the following apply.\r
• There is more than one gallery.\r
• The total aggregate area of all the galleries in one space is more than half the floor area of that space."""@en ;
    rdfs:subClassOf bot:Building ;
    owl:disjointWith ficr:SingleStoreyBuilding .

ficr:Office a owl:Class,
        owl:NamedIndividual,
        ficr:Office,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Office"@en ;
    rdfs:comment """Offices or premises used for any of the following and their control:\r
• administration\r
• clerical work (including writing, bookkeeping, sorting papers, filing, typing, duplicating, machine calculating, drawing and the editorial preparation of matter for publication, police and fire and rescue service work)\r
• handling money (including banking and building society work)\r
• communications (including postal, telegraph and radio communications)\r
• radio, television, film, audio or video recording\r
• performance (premises not open to the public)."""@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:ProtectedEntranceHall a owl:Class ;
    rdfs:label "ProtectedEntranceHall"@en ;
    rdfs:comment "A circulation area, consisting of a hall or space in a flat, that is enclosed with fire resisting construction other than an external wall of a building."@en ;
    rdfs:subClassOf ficr:FireProtectionSpatialProvision ;
    owl:disjointWith ficr:ProtectedLobby,
        ficr:ProtectedShaft,
        ficr:ProtectedStairwaySpace ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bot:Zone [ a owl:Restriction ;
                        owl:onProperty ficr:hasZoneFireSafetyRole ;
                        owl:someValuesFrom ficr:PassiveFireProtectionRole ] [ a owl:Restriction ;
                        owl:hasValue ficr:EntranceHall ;
                        owl:onProperty ficr:hasSpaceUsage ] ) ] .

ficr:PurposeGroup1a a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup1,
        ficr:PurposeGroup1a,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup1a"@en ;
    rdfs:comment "A flat is a separate and self-contained premises constructed or adapted for use for residential purposes and forming part of a building from some other part of which it is divided horizontally."@en ;
    rdfs:subClassOf ficr:PurposeGroup1 .

ficr:PurposeGroup1c a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup1,
        ficr:PurposeGroup1c,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup1c"@en ;
    rdfs:comment "Dwellinghouse that does not contain a habitable storey with a floor level a minimum of 4.5m above ground level."@en ;
    rdfs:subClassOf ficr:PurposeGroup1 .

ficr:PurposeGroup2a a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup2,
        ficr:PurposeGroup2a,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup2a"@en ;
    rdfs:comment """Hospital, home, school or other similar establishment, where people sleep on the premises. The building may be either of the following:\r
• Living accommodation for, or accommodation for the treatment, care or maintenance of, either:\r
    - disabled people with a range of impairments including physical, sensory and\r
cognitive impairments, or mental health conditions\r
    - people under the age of 5 years.\r
• A place of lawful detention."""@en ;
    rdfs:subClassOf ficr:PurposeGroup2 .

ficr:PurposeGroup2b a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup2,
        ficr:PurposeGroup2b,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup2b"@en ;
    rdfs:comment "Hotel, boarding house, residential college, hall of residence, hostel or any other residential purpose not described above."@en ;
    rdfs:subClassOf ficr:PurposeGroup2 .

ficr:PurposeGroup3 a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup3,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup3"@en ;
    rdfs:comment """Offices or premises used for any of the following and their control:\r
• administration\r
• clerical work (including writing, bookkeeping, sorting papers, filing, typing, duplicating, machine calculating, drawing and the editorial preparation of matter for publication, police and fire and rescue service work)\r
• handling money (including banking and building society work)\r
• communications (including postal, telegraph and radio communications)\r
• radio, television, film, audio or video recording\r
• performance (premises not open to the public)."""@en ;
    rdfs:subClassOf ficr:PurposeGroup .

ficr:PurposeGroup4 a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup4,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup4"@en ;
    rdfs:comment """Shops or premises used for either of the following.\r
• A retail trade or business (including selling food or drink to the public for immediate consumption, retail by auction, self-selection and over-the-counter wholesale trading, the business of lending books or periodicals for gain, the business of a barber or hairdresser, and the rental of storage space to the public).\r
• Premises to which the public are invited either:\r
    – to deliver or collect goods in connection with their hire, repair or other treatment\r
    – (except in the case of repair of motor vehicles) where the public themselves may carry out such repairs or other treatments."""@en ;
    rdfs:subClassOf ficr:PurposeGroup .

ficr:PurposeGroup5 a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup5,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup5"@en ;
    rdfs:comment """Place of assembly, entertainment or recreation, including any of the following:\r
• bingo halls, broadcasting, recording and film studios open to the public, casinos, dance halls\r
• entertainment, conference, exhibition and leisure centres\r
• funfairs and amusement arcades\r
• museums and art galleries, non-residential clubs, theatres, cinemas, concert halls\r
• educational establishments, dancing schools, gymnasia, swimming pool buildings, riding schools, skating rinks, sports pavilions, sports stadia\r
• law courts\r
• churches and other buildings of worship, crematoria\r
• libraries open to the public, non-residential day centres, clinics, health centres and surgeries\r
• passenger stations and termini for air, rail, road or sea travel\r
• public toilets\r
• zoos and menageries."""@en ;
    rdfs:subClassOf ficr:PurposeGroup .

ficr:PurposeGroup6 a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup6,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup6"@en ;
    rdfs:comment """Factories and other premises used for any of the following:\r
• manufacturing, altering, repairing, cleaning, washing, breaking up, adapting or processing any article\r
• generating power\r
• slaughtering livestock."""@en ;
    rdfs:subClassOf ficr:PurposeGroup .

ficr:PurposeGroup7a a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup7,
        ficr:PurposeGroup7a,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup7a"@en ;
    rdfs:comment """Either of the following:\r
• place (other than described under 7(b)) for the storage or deposit of goods or materials\r
• any building not within purpose groups 1 to 6."""@en ;
    rdfs:subClassOf ficr:PurposeGroup7 .

ficr:PurposeGroup7b a owl:Class,
        owl:NamedIndividual,
        ficr:Classification,
        ficr:PurposeGroup,
        ficr:PurposeGroup7,
        ficr:PurposeGroup7b,
        ficr:RegulatoryClassification ;
    rdfs:label "PurposeGroup7b"@en ;
    rdfs:comment "Car parks designed to admit and accommodate only cars, motorcycles and passenger or light goods vehicles that weigh a maximum of 2500kg gross."@en ;
    rdfs:subClassOf ficr:PurposeGroup7 .

ficr:ResidentialCollege a owl:Class,
        owl:NamedIndividual,
        ficr:ResidentialCollege,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "ResidentialCollege"@en ;
    rdfs:comment "A utilization purpose for a college providing on-site residential accommodation for students."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:RoutineTriggerEvent a owl:Class ;
    rdfs:label "RoutineTriggerEvent"@en ;
    rdfs:comment "A trigger event generated from routine schedules or planned inspection cycles derived from FiCR maintenance and regulatory schedules, such as monthly fire exit checks."@en ;
    rdfs:subClassOf ficr:Event .

ficr:School a owl:Class,
        owl:NamedIndividual,
        ficr:School,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "School"@en ;
    rdfs:comment "A place of education for children between 2 and 19 years old. The term includes nursery schools, primary schools and secondary schools as defined in the Education Act 1996."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:ShelteredHousing a owl:Class,
        owl:NamedIndividual,
        ficr:ShelteredHousing,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "ShelteredHousing"@en ;
    rdfs:comment "Includes two or more dwellings in the same building or on adjacent sites, designed and constructed as residential accommodation for vulnerable or elderly people who receive, or will receive, a support service."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:Shop a owl:Class,
        owl:NamedIndividual,
        ficr:Shop,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Shop"@en ;
    rdfs:comment """Shops or premises used for either of the following.\r
• A retail trade or business (including selling food or drink to the public for immediate consumption, retail by auction, self-selection and over the-counter wholesale trading, the business of lending books or periodicals for gain, the business of a barber or hairdresser, and the rental of storage space to the public).\r
• Premises to which the public are invited either:\r
– to deliver or collect goods in connection with their hire, repair or other treatment\r
– (except in the case of repair of motor vehicles) where the public themselves may carry out such repairs or other treatments."""@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:SingleStoreyBuilding a owl:Class ;
    rdfs:label "SingleStoreyBuilding"@en ;
    rdfs:comment "A building that consists of a ground storey only. Basements are not counted as storeys in a building (see Appendix D). A separated part that consists of a ground storey only, with a roof to which access is only provided for repair or maintenance, may be treated as a single storey building."@en ;
    rdfs:subClassOf bot:Building .

ficr:SiteBoundary a owl:Class ;
    rdfs:label "SiteBoundary"@en ;
    rdfs:comment "A spatial boundary representing the extent of the site or land associated with a building. This class is not used to represent fire compartment boundaries or boundary condition records."@en ;
    rdfs:subClassOf bot:Zone .

ficr:SpecifiedAttachment a owl:Class ;
    rdfs:label "SpecifiedAttachment"@en ;
    rdfs:comment """Includes any of the following.\r
• A balcony attached to an external wall.\r
• A device for reducing heat gain within a building by deflecting sunlight which is attached to an external wall."""@en ;
    rdfs:subClassOf ficr:FabricElement .

ficr:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    rdfs:comment "Technical standards, codes, or guides issued by standards organizations are typically technical specifications; whether they are mandatory depends on whether they are cited in regulations, contracts, or by an authority."@en ;
    rdfs:subClassOf ficr:RegulatorySource .

ficr:Storage a owl:Class,
        owl:NamedIndividual,
        ficr:Storage,
        ficr:UsageType,
        ficr:UtilizationPurpose ;
    rdfs:label "Storage"@en ;
    rdfs:comment "A utilization purpose for premises used for storing goods or materials."@en ;
    rdfs:subClassOf ficr:UtilizationPurpose .

ficr:StoreyExitRole a owl:Class,
        owl:NamedIndividual,
        ficr:EscapeAndEvacuationRole,
        ficr:FireSafetyRole,
        ficr:StoreyExitRole,
        ficr:UsageType ;
    rdfs:label "StoreyExitRole"@en ;
    rdfs:comment """A final exit, or a doorway that gives direct access into a protected stairway, firefighting lobby or external escape route.\r
NOTE: If an institutional building is planned to enable progressive horizontal evacuation, a door in a compartment wall is considered a storey exit for the purposes of requirement B1."""@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:UnprotectedAreaRole a owl:Class,
        owl:NamedIndividual,
        ficr:FireProtectionRole,
        ficr:FireSafetyRole,
        ficr:UnprotectedAreaRole,
        ficr:UsageType ;
    rdfs:label "UnprotectedAreaRole"@en ;
    rdfs:comment """Unprotected area (in relation to a side or external wall of a building) All of the following are classed as unprotected areas.\r
• Any part of the external wall that has less than the relevant fire resistance set out in Section 11.\r
• Any part of the external wall constructed of material more than 1mm thick if that material does not have a class B-s3, d2 rating or better, which is attached or applied, whether for cladding or any other purpose.\r
• Windows, doors or other openings. This does not include windows that are designed and glazed to give the necessary level of fire resistance and that are not openable.\r
NOTE: Recessed car parking areas as shown in\r
Diagram A1 should not be regarded as unprotected\r
areas."""@en ;
    rdfs:subClassOf ficr:FireProtectionRole .

ficr:hasClassification a owl:ObjectProperty ;
    rdfs:label "hasClassification"@en ;
    rdfs:comment "General property relating an entity to its classification."@en ;
    owl:inverseOf ficr:isClassificationOf .

ficr:isComponentOf a owl:ObjectProperty ;
    rdfs:label "isComponentOf"@en ;
    rdfs:comment "Links an individual equipment item to the building system it belongs to. Inverse direction of hasComponent at the instance level."@en .

ficr:isPhysicalObjectFireSafetyRoleOf a owl:ObjectProperty ;
    rdfs:label "isPhysicalObjectFireSafetyRoleOf"@en ;
    rdfs:comment "Inverse of hasPhysicalObjectFireSafetyRole"@en ;
    rdfs:subPropertyOf ficr:isFireSafetyRoleOf .

ficr:isPurposeGroupOf a owl:ObjectProperty ;
    rdfs:label "isPurposeGroupOf"@en ;
    rdfs:comment "Inverse of hasPurposeGroup."@en ;
    rdfs:subPropertyOf ficr:isClassificationOf .

ficr:isSpaceUsageOf a owl:ObjectProperty ;
    rdfs:label "isSpaceUsageOf"@en ;
    rdfs:comment "Inverse of hasSpaceUsage."@en ;
    rdfs:subPropertyOf ficr:isUsageTypeOf .

ficr:isSystemContainedIn a owl:ObjectProperty ;
    rdfs:label "isSystemContainedIn"@en ;
    rdfs:comment "inverseOf containsSystem"@en ;
    rdfs:domain ficr:BuildingSystem ;
    rdfs:range bot:Zone .

ficr:isSystemFireSafetyRoleOf a owl:ObjectProperty ;
    rdfs:label "isSystemFireSafetyRoleOf"@en ;
    rdfs:comment "Inverse of hasFireSafetyRole, linking a fire safety role to the system or element that bears it."@en ;
    rdfs:subPropertyOf ficr:isFireSafetyRoleOf .

ficr:isUtilizationPurposeOf a owl:ObjectProperty ;
    rdfs:label "isUtilizationPurposeOf"@en ;
    rdfs:comment "Inverse of hasUtilizationPurpose."@en ;
    rdfs:subPropertyOf ficr:isUsageTypeOf .

ficr:isZoneFireSafetyRoleOf a owl:ObjectProperty ;
    rdfs:label "isZoneFireSafetyRoleOf"@en ;
    rdfs:comment "Inverse of hasZoneFireSafetyRole."@en ;
    rdfs:subPropertyOf ficr:isFireSafetyRoleOf .

ficr:triggersTask a owl:ObjectProperty ;
    rdfs:label "triggersTask"@en ;
    rdfs:comment "Links a trigger event to the task(s) created because of it."@en ;
    rdfs:domain ficr:Event ;
    rdfs:range ficr:Task .

<urn:ficr:config:case:rei_assignments%2Freq_floor_above%2F1CZILmCaHETO8tf3SgGEWh> a owl:Thing .

<urn:ficr:config:case:rei_assignments%2Freq_floor_above%2F1CZILmCaHETO8tf3SgGEXu> a owl:Thing .

<urn:ficr:config:case:rei_assignments%2Freq_floor_above%2F1hOSvn6df7F8_7GcBWlRqU> a owl:Thing .

<urn:ficr:config:case:rei_assignments%2Freq_floor_above%2F1hOSvn6df7F8_7GcBWlRrM> a owl:Thing .

<urn:ficr:config:case:rei_assignments%2Freq_floor_above%2F2O2Fr%24t4X7Zf8NOew3FK4F> a owl:Thing .

<urn:ficr:config:case:rei_assignments%2Freq_floor_above%2F2O2Fr%24t4X7Zf8NOew3FKcz> a owl:Thing .

