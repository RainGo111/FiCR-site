bot:hasSubElement a owl:ObjectProperty ;
    rdfs:label "té un subelement"@ca,
        "má součást"@cs,
        "har underbygningsdel"@da,
        "hat Unterbauteil"@de,
        "has sub-element"@en,
        "alberga sub elemento"@es,
        "زیرالمان دارد"@fa,
        "omaa osaelementin"@fi,
        "a sous-élément"@fr,
        "ha sotto-elemento"@it,
        "heeft subelement"@nl,
        "tem sub elemento"@pt,
        "má súčasť"@sk,
        "värd för sub element"@sv,
        "alt öğesi var"@tr,
        "包含子构件"@zh-cn ;
    rdfs:comment "Relació entre dos elements de construcció, ja sigui un element que allotja un altre (per exemple, una mur que conté una finestra) o una subcomposició d'un element de construcció en parts més petites (per exemple, una unitat de ventilació té una part que és un ventilador)."@ca,
        "Vztah mezi prvkem a) a dalším prvkem b), který je součástí prvku a)"@cs,
        "Relation mellem to bygningsdele, enten en bygningsdel, der er \"hostet\" af en anden (fx et vindue, der \"hostet\" af en væg) eller en underkomposition af en bygningsdel i mindre dele (fx en ventilator som en del af et ventilationsaggregat)."@da,
        "Beziehung zwischen zwei Bauteilen, wobei entweder eines das andere enthält (z.B. eine Wand enthält ein Fenster) oder ein ganzes, das aus anderen Teilen zusammen gesetzt ist (z.B. eine Lüftungsanlage hat eine Komponente Lüfter)."@de,
        "Relation between two building elements, either one element hosting another (e.g. a wall hosts a window) or a subcomposition of a building element into smaller parts (e.g. an air handling unit has as a part a fan)."@en,
        "Relación entre dos elementos de construcción, ya sea un elemento que aloja a otro (por ejemplo, una ventana alojada en una pared) o una subcomposición de un elemento de construcción en partes más pequeñas (por ejemplo, una unidad de ventilación tiene una parte que es un ventilador)."@es,
        "ارتباط بین دو المان ساختمان؛ یا رابطه یک المان میزبان با المان دیگر (برای مثال یک پنجره میزبانی میشود توسط یک دیوار)؛ یا رابطه یک المان با زیرمجموعه‌ای از المانهای کوچکتر ساختمان (برای مثال یک فن به عنوان بخشی از واحد کنترل هوا)."@fa,
        "Suhde kahden elementin välillä, joko yhdestä elementistä siihen asennettuun toiseen elementtiin (esimerkiksi seinään asennettu ikkuna) tai elementin osittelu pienempiin osiin (esimerkiksi ilmankäsittelykonella on osana puhallin)."@fi,
        "Relation entre deux éléments du bâti, soit un élément hébergeant un autre (ex., un mur héberge une fenêtre), ou une décomposition d'un élément en sous-parties (ex., un système de gestion de l'air et un ventilateur qu'il contient)"@fr,
        "Relazione tra due elementi di costruzione che può realizzarsi perché un elemento ne ospita un altro (es. un muro ospita una finestra) o la scomposizione di un elemento in parti più piccole (es. un'unità di trattamento aria ha un ventilatore come sua parte)."@it,
        "Relatie tussen twee gebouwelementen, ofwel één element dat een andere element bevat (bv. een muur die een raam bevat) of een subcompositie van een gebouwelement in kleinere delen (bv. een luchtbehandelingskast die een ventilator bevat)."@nl,
        "Relação entre dois elementos arquitectónicos, quer seja um elemento contendo outro (p.e. uma parede aloja uma janela) ou a subcomposição de um elemento arquitectónico por partes menores (p.e. uma unidade de ventilação contém uma parte que é um ventilador)."@pt,
        "Vzťah medzi prvkom a) a ďalším prvkom b), ktorý je súčasťou prvku a)"@sk,
        "Relation mellan två byggdelar där antingen endera är monterad i den andra (t.ex. ett fönster som är monterat i en vägg) eller endera är del av den andra (t.ex. en fläkt som är del av ett ventilationsaggregat)."@sv,
        "Bir a) bina parçası ve b) bina parçası arasındaki bağlantının a) tarafından barındırmasıdır. Örneğin: inst:wall bot:hasSubElement inst:window."@tr,
        "两个建筑构件之间的关系，要么是一个元素承载另一个元素（例如，一扇窗户由墙壁承载），要么是将建筑构件细分为较小的部分（例如，作为空气处理单元一部分的风扇）。"@zh-cn ;
    rdfs:domain bot:Element ;
    rdfs:isDefinedBy bot: ;
    rdfs:range bot:Element ;
    vs:term_status "stable" .

ficr:ActiveFireProtectionRole a owl:Class,
        owl:NamedIndividual,
        ficr:ActiveFireProtectionRole,
        ficr:FireProtectionRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "ActiveFireProtectionRole"@en ;
    rdfs:comment "A fire protection role involving active detection, alarm, suppression, control, release, emergency lighting, or operational response. This role is typically assigned to fire protection systems or equipment."@en ;
    rdfs:subClassOf ficr:FireProtectionRole .

ficr:CavitySpace a owl:Class ;
    rdfs:label "CavitySpace"@en ;
    rdfs:comment "A space enclosed by elements of a building (including a suspended ceiling) or contained within an element, but that is not a room, cupboard, circulation space, protected shaft, or space within a flue, chute, duct, pipe or conduit."@en ;
    rdfs:subClassOf bot:Space ;
    owl:disjointWith ficr:DuctSpace,
        ficr:RoofSpace,
        ficr:RoomSpace,
        ficr:ShaftSpace,
        ficr:StairSpace .

ficr:Circuit a owl:Class ;
    rdfs:label "Circuit"@en ;
    rdfs:comment "A continuous pathway that allows electricity to flow from the main supply (consumer unit) to various outlets, lights, or appliances, and back again."@en ;
    rdfs:subClassOf ficr:ElectricalSystem .

ficr:Corridor a owl:Class,
        owl:NamedIndividual,
        ficr:CirculationUsage,
        ficr:Corridor,
        ficr:SpaceUsage,
        ficr:UsageType ;
    rdfs:label "Corridor"@en ;
    rdfs:comment """A corridor is a long, narrow passageway in a building that connects different rooms or areas.\r
A design of a building containing flats, in which each flat is approached via a common horizontal internal access or circulation space, which may include a common entrance hall."""@en ;
    rdfs:subClassOf ficr:CirculationUsage ;
    owl:disjointWith ficr:EntranceHall,
        ficr:Foyer,
        ficr:Hall,
        ficr:Lobby .

ficr:DrawingEvidence a owl:Class ;
    rdfs:label "DrawingEvidence"@en ;
    rdfs:comment "A document evidence item representing a drawing that supports an assessment finding or record."@en ;
    rdfs:subClassOf ficr:DocumentEvidence .

ficr:EngineRoom a owl:Class,
        owl:NamedIndividual,
        ficr:EngineRoom,
        ficr:PlaceOfSpecialHazard,
        ficr:SpaceUsage,
        ficr:UsageType ;
    rdfs:label "EngineRoom"@en ;
    rdfs:comment "In buildings, an \"engine room\" typically refers to the central location for the mechanical and electrical systems that keep the building running, such as HVAC, boilers, generators, and pumps."@en ;
    rdfs:subClassOf ficr:PlaceOfSpecialHazard ;
    owl:disjointWith ficr:FuelStorage,
        ficr:SwitchGearRoom,
        ficr:TransformerRoom .

ficr:EvacuationRole a owl:Class,
        owl:NamedIndividual,
        ficr:EscapeAndEvacuationRole,
        ficr:EvacuationRole,
        ficr:FireSafetyRole,
        ficr:UsageType ;
    rdfs:label "EvacuationRole"@en ;
    rdfs:comment "The route along which people can escape from any point in a building to a final exit."@en ;
    rdfs:subClassOf ficr:EscapeAndEvacuationRole .

ficr:EvidenceInsufficient a owl:Class,
        owl:NamedIndividual,
        ficr:AssessmentState,
        ficr:EvidenceInsufficient,
        ficr:EvidenceStatus ;
    rdfs:label "EvidenceInsufficient"@en ;
    rdfs:comment "An evidence status indicating that supporting evidence is available but insufficient for the finding or record."@en ;
    rdfs:subClassOf ficr:EvidenceStatus ;
    owl:disjointWith ficr:EvidenceMissing,
        ficr:EvidenceNotRequired .

ficr:FirefightingRole a owl:Class,
        owl:NamedIndividual,
        ficr:FireSafetyRole,
        ficr:FirefightingRole,
        ficr:FirefightingSupportRole,
        ficr:UsageType ;
    rdfs:label "FirefightingRole"@en ;
    rdfs:comment "Firefighting in buildings is the strategic and tactical process used by the fire and rescue service to control and extinguish fires, protect lives and property, and manage associated hazards within a built structure."@en ;
    rdfs:subClassOf ficr:FirefightingSupportRole .

ficr:FirefightingSupportRole a owl:Class ;
    rdfs:label "FirefightingSupportRole"@en ;
    rdfs:comment "A fire safety role related to firefighter access, firefighting support, fire service intervention, or systems and spaces designated to support firefighting operations."@en ;
    rdfs:subClassOf ficr:FireSafetyRole .

ficr:Impaired a owl:Class,
        owl:NamedIndividual,
        ficr:AssessmentState,
        ficr:Impaired,
        ficr:ImpairmentState ;
    rdfs:label "Impaired"@en ;
    rdfs:comment "The system is out of service, degraded, or bypassed."@en ;
    rdfs:subClassOf ficr:ImpairmentState ;
    owl:disjointWith ficr:ImpairmentUnknown,
        ficr:Operational .

ficr:InstallationUnknown a owl:Class,
        owl:NamedIndividual,
        ficr:AssessmentState,
        ficr:InstallationStatus,
        ficr:InstallationUnknown ;
    rdfs:label "InstallationUnknown"@en ;
    rdfs:comment "An installation status indicating that whether the system or component is installed is unknown."@en ;
    rdfs:subClassOf ficr:InstallationStatus ;
    owl:disjointWith ficr:Installed,
        ficr:NotInstalled,
        ficr:PartiallyInstalled .

ficr:NotApplicable a owl:Class,
        owl:NamedIndividual,
        ficr:ApplicabilityState,
        ficr:AssessmentState,
        ficr:NotApplicable ;
    rdfs:label "NotApplicable"@en ;
    rdfs:comment "An applicability state indicating that the requirement, rule, or assessment condition does not apply in the given context."@en ;
    rdfs:subClassOf ficr:ApplicabilityState ;
    owl:disjointWith ficr:NotAssessed .

ficr:PipingSystem a owl:Class ;
    rdfs:label "PipingSystem"@en ;
    rdfs:comment "A building system composed of pipes, fittings, valves, and related components for conveying water, gas, or other fluids within or through a building."@en ;
    rdfs:subClassOf ficr:BuildingSystem .

ficr:ProtectedLobby a owl:Class ;
    rdfs:label "ProtectedLobby"@en ;
    rdfs:comment "A corridor or lobby that is adequately protected from fire in adjoining areas by fire resisting construction."@en ;
    rdfs:subClassOf ficr:FireProtectionSpatialProvision ;
    owl:disjointWith ficr:ProtectedShaft,
        ficr:ProtectedStairwaySpace ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( bot:Zone [ a owl:Restriction ;
                        owl:onProperty ficr:hasZoneFireSafetyRole ;
                        owl:someValuesFrom ficr:PassiveFireProtectionRole ] [ a owl:Restriction ;
                        owl:hasValue ficr:Lobby ;
                        owl:onProperty ficr:hasSpaceUsage ] ) ] .

ficr:RoofSlab a owl:Class ;
    rdfs:label "RoofSlab"@en ;
    rdfs:comment "A horizontal structural slab forming the topmost floor of a building, directly supporting the roof covering and transferring loads to walls or columns."@en ;
    rdfs:subClassOf ficr:Roof,
        ficr:Slab .

ficr:containsSystem a owl:ObjectProperty ;
    rdfs:label "containsSystem"@en ;
    rdfs:comment "Relates a spatial zone to a building system located in, passing through, or spatially associated with that zone. This property is used where a system-level entity should not be treated as a BOT element."@en ;
    rdfs:domain bot:Zone ;
    rdfs:range ficr:BuildingSystem ;
    owl:inverseOf ficr:isSystemContainedIn .

ficr:isAboveGround a owl:DatatypeProperty ;
    rdfs:label "isAboveGround"@en ;
    rdfs:comment "Determine whether the storey is a basement or above ground."@en ;
    rdfs:domain bot:Storey ;
    rdfs:range xsd:boolean .

ficr:isClassificationOf a owl:ObjectProperty ;
    rdfs:label "isClassificationOf"@en ;
    rdfs:comment "Inverse of hasClassification."@en .

