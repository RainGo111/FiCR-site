<urn:ficr:inspection-policy:service-deadline> a owl:Thing ;
    dcterms:description "Pass iff the recorded service/replacement deadline is on or after assessed date. Earlier is deficiency. A missing date or insufficient/missing support makes this check unresolved."^^xsd:string .

